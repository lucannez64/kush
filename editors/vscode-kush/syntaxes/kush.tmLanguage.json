{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kush",
  "scopeName": "source.kush",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#functions" },
    { "include": "#module-paths" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#lifetimes" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kush",
          "match": "//.*$"
        },
        {
          "name": "comment.block.kush",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.modifier.attribute.kush",
          "match": "#\\[(?:noalloc|nosuspend|test|linear)\\]"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.kush" },
            "2": { "name": "entity.name.function.kush" }
          }
        }
      ]
    },
    "module-paths": {
      "patterns": [
        {
          "match": "\\b(module|use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.import.kush" },
            "2": { "name": "entity.name.namespace.kush" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "entity.name.type.kush",
          "match": "\\b(?:enum|struct|type|trait|effect|prop)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.kush" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kush",
          "match": "\\b(?:pub|let|mut|return|if|else|match|enum|struct|type|trait|impl|module|use|erased|ensures|where|algebra|dyn|const|while|loop|break|continue|perform|with|effect|prop|true|false|fn)\\b"
        },
        {
          "name": "keyword.control.kush",
          "match": "\\b(?:is|as|for)(?=\\s+[A-Za-z_])"
        },
        {
          "name": "keyword.control.kush",
          "match": "\\btotal(?=\\s+(?:fn|enum)\\b)|\\bhandle(?=\\s+[A-Za-z_]\\w*\\s*:)|\\binvariant(?=\\s*\\{)"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.kush",
          "match": "\\b(?:print_i64|panic)\\b"
        },
        {
          "name": "support.class.kush",
          "match": "\\b(?:IO|Bytes|String|Str|Vec|Box|Arena|ArenaBox|AllocBox|AllocVec|Task|TaskExit|Slice|DynArray|Option|Result|Stdin|Stdout)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.kush",
          "match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|Bool|Unit|Char|Nat|Prop|Level|Grade|Effects)\\b"
        }
      ]
    },
    "lifetimes": {
      "patterns": [
        {
          "name": "entity.name.type.lifetime.kush",
          "match": "'[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kush",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.kush",
              "match": "\\\\[nrt0\\\\\"']"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.kush",
          "match": "'(?:[^'\\\\]|\\\\.)'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.kush",
          "match": "\\b(?:0|[1-9][0-9_]*)(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.kush",
          "match": "->|=>|::|==|!=|<=|>=|&&|\\|\\||<<|>>|[+\\-*/%^<>=!&|?@.]"
        }
      ]
    }
  }
}
