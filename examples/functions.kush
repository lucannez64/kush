module examples.functions;

// First-class functions: named values, explicit generic specialization,
// noncapturing lambdas, owning once closures, arrow subtyping, and a generic
// higher-order map over Vec.

struct Pair {
    left: i64,
    right: i64,
}

fn inc(x: i64) -> i64 ! {panic} { x + 1 }

fn double(x: i64) -> i64 ! {panic} { x * 2 }

fn id<T>(x: T) -> T ! {panic} { x }

// A wider parameter domain is contravariant: `classify` can be used wherever
// only `fn(i64) -> i64` is promised.
fn classify(x: i64 | Bool) -> i64 ! {panic} {
    match x {
        i64 @n => n,
        Bool @b => if b { 1 } else { 0 },
    }
}

fn apply(f: fn(i64) -> i64 ! {panic}, x: i64) -> i64 ! {panic} {
    f(x)
}

// Usage grades are part of the arrow contract and are propagated to the call.
fn twice_graded(x: i64 @[2]) -> i64 ! {panic} { x + x }

fn apply_twice(f: fn(i64 @[2]) -> i64 ! {panic}, x: i64 @[2]) -> i64 ! {panic} {
    f(x)
}

fn make_pair(x: i64) -> Pair ! {panic} {
    Pair { left: x, right: x + 2 }
}

fn pair_sum(f: fn(i64) -> Pair ! {panic}, x: i64) -> i64 ! {panic} {
    let p = f(x);
    p.left + p.right
}

fn map<T, U>(values: Vec<T>, f: fn(T) -> U ! {alloc, panic}) -> Vec<U> ! {alloc, panic} {
    let mut out: Vec<U> = Vec.new();
    let mut i = 0;
    while i < Vec.len(&values) {
        out = Vec.push(out, f(Vec.get(&values, i)));
        i = i + 1;
    }
    out
}

// A capturing closure owns its environment exactly once. The returned value is
// `once fn`, so it may be called at most once and is dropped otherwise.
fn compose(f: fn(i64) -> i64 ! {panic}, g: fn(i64) -> i64 ! {panic}) -> (once fn(i64) -> i64 ! {alloc, panic}) ! {alloc, panic} {
    fn(x: i64) -> i64 ! {panic} { g(f(x)) }
}

fn main() -> Unit ! {io, alloc, panic} {
    print_i64(apply(inc, 41)); // 42
    print_i64(apply(classify, 42)); // 42, with union injection
    print_i64(apply(id::<i64>, 42)); // 42, specialized generic value
    print_i64(apply_twice(twice_graded, 21)); // 42, graded arrow contract
    print_i64(pair_sum(make_pair, 20)); // 20 + 22

    let mut values: Vec<i64> = Vec.new();
    values = Vec.push(values, 10);
    values = Vec.push(values, 11);
    let mapped = map(values, double); // [20, 22]
    print_i64(Vec.get(&mapped, 0) + Vec.get(&mapped, 1));

    let pipeline = compose(inc, double); // once closure capturing two fns
    print_i64(pipeline(20)); // double(21)

    let base = Box.new(41);
    let add_base = fn(x: i64) -> i64 ! {panic} { Box.take(base) + x };
    print_i64(add_base(1)); // 42
}
