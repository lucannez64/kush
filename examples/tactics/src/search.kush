module tactics.search;

// Tactics are ordinary functions (docs/tactics-handlers.md, section 3).
//
// Each takes the search capability `op`, a context, a goal and a depth, and
// returns a proof of the goal in the context: a store id. A tactic that
// cannot make progress performs `fail(op)`, a choice among no alternatives,
// so the search handler goes back to the last choice with alternatives
// left and resumes the rest of the search from there. Every value a tactic
// keeps across a choice is an integer, so each alternative starts from its
// own copy of them.

use tactics.state;
use tactics.state.Choose;
use tactics.state.Goal;
use tactics.state.Query;

/// Ask the engine (the `Goal` handler owns the kernel).
pub fn ask(q: Query) -> i64 ! {Goal, alloc, panic} {
    perform Goal(q)
}

/// One of `0..n`, chosen by the search.
pub fn choose(op: cap multi Choose ! {panic}, n: i64) -> i64 ! {Goal, alloc, panic} {
    let i = perform op(n);
    ask(Query.Chosen(i));
    i
}

/// Give up on this branch: a choice among no alternatives.
pub fn fail(op: cap multi Choose ! {panic}) -> i64 ! {Goal, alloc, panic} {
    perform op(0)
}

/// Close the goal with a hypothesis whose type is the goal.
pub fn assumption(op: cap multi Choose ! {panic}, context: i64, goal: i64) -> i64 ! {Goal, alloc, panic} {
    let i = choose(op, ask(Query.Length(context)));
    let ty = ask(Query.Hypothesis(context, i));
    if ask(Query.Defeq(context, ty, goal)) == 1 {
        ask(Query.Var(i))
    } else {
        fail(op)
    }
}

/// Apply a hypothesis `h : A1 -> .. -> An -> B` whose conclusion `B` is the
/// goal, proving each premise `Ai` with `auto`.
pub fn apply(op: cap multi Choose ! {panic}, context: i64, goal: i64, depth: i64) -> i64 ! {Goal, alloc, panic} {
    let i = choose(op, ask(Query.Length(context)));
    let mut proof = ask(Query.Var(i));
    let mut ty = ask(Query.Hypothesis(context, i));
    loop {
        if ask(Query.Defeq(context, ty, goal)) == 1 {
            return proof;
        }
        let head = ask(Query.Whnf(context, ty));
        if head < 0 || ask(Query.Shape(head)) != state.PI {
            return fail(op);
        }
        let premise = ask(Query.Part(head, 0));
        let conclusion = ask(Query.Part(head, 1));
        let argument = auto(op, context, premise, depth);
        proof = ask(Query.App(proof, argument));
        ty = ask(Query.Instantiate(conclusion, argument));
    }
}

/// Use a hypothesis `P & Q`, `P | Q` or `False`: prove the goal from its
/// parts with `auto`, then eliminate the hypothesis into it.
pub fn cases(op: cap multi Choose ! {panic}, context: i64, goal: i64, depth: i64) -> i64 ! {Goal, alloc, panic} {
    let i = choose(op, ask(Query.Length(context)));
    let head = ask(Query.Whnf(context, ask(Query.Hypothesis(context, i))));
    if head < 0 {
        return fail(op);
    }
    let shape = ask(Query.Shape(head));
    let h = ask(Query.Var(i));
    if shape == state.FALSE {
        return ask(Query.ElimFalse(h, goal));
    }
    if shape != state.AND && shape != state.OR {
        return fail(op);
    }
    let p = ask(Query.Part(head, 0));
    let q = ask(Query.Part(head, 1));
    let lifted = ask(Query.Shift(goal, 1));
    if shape == state.AND {
        // P -> Q -> G, with Q and G under the binder of P.
        let q1 = ask(Query.Shift(q, 1));
        let g2 = ask(Query.Shift(goal, 2));
        let target = ask(Query.Pi(p, ask(Query.Pi(q1, g2))));
        let both = auto(op, context, target, depth);
        return ask(Query.App(ask(Query.ElimAnd(h, goal)), both));
    }
    let from_left = auto(op, context, ask(Query.Pi(p, lifted)), depth);
    let from_right = auto(op, context, ask(Query.Pi(q, lifted)), depth);
    ask(Query.App(ask(Query.App(ask(Query.ElimOr(h, goal)), from_left)), from_right))
}

/// Prove one side of a disjunction.
pub fn either(op: cap multi Choose ! {panic}, context: i64, goal: i64, depth: i64) -> i64 ! {Goal, alloc, panic} {
    let p = ask(Query.Part(goal, 0));
    let q = ask(Query.Part(goal, 1));
    if choose(op, 2) == 0 {
        let a = auto(op, context, p, depth);
        ask(Query.OrLeft(p, q, a))
    } else {
        let b = auto(op, context, q, depth);
        ask(Query.OrRight(p, q, b))
    }
}

/// The proof search: introduce and split eagerly (they never lose a
/// proof), then choose a rule. `depth` bounds the rules applied along a
/// branch; the driver deepens it until a proof is found.
pub fn auto(op: cap multi Choose ! {panic}, context: i64, goal: i64, depth: i64) -> i64 ! {Goal, alloc, panic} {
    let head = ask(Query.Whnf(context, goal));
    if head < 0 {
        return fail(op);
    }
    let shape = ask(Query.Shape(head));
    if shape == state.PI {
        let domain = ask(Query.Part(head, 0));
        let body = ask(Query.Part(head, 1));
        let proof = auto(op, ask(Query.Extend(context, domain)), body, depth);
        return ask(Query.Lam(domain, proof));
    }
    if shape == state.AND {
        let p = ask(Query.Part(head, 0));
        let q = ask(Query.Part(head, 1));
        let a = auto(op, context, p, depth);
        let b = auto(op, context, q, depth);
        return ask(Query.AndIntro(p, q, a, b));
    }
    if depth <= 0 {
        return fail(op);
    }
    let rule = choose(op, if shape == state.OR { 4 } else { 3 });
    if rule == 0 {
        assumption(op, context, head)
    } else if rule == 1 {
        apply(op, context, head, depth - 1)
    } else if rule == 2 {
        cases(op, context, head, depth - 1)
    } else {
        either(op, context, head, depth - 1)
    }
}
