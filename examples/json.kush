// A bounded JSON parser/minifier: kush run examples/json.kush < input.json
use std.result.Result;
use std.json;

fn report(error: json.Error) -> i64 ! {io, alloc, panic} {
    let text = json.message(error);
    match IO.write(IO.stdout(), &text) { Ok(_) => {}, Err(_) => { return 1; } };
    let location = Bytes.from(" at byte ");
    match IO.write(IO.stdout(), &location) { Ok(_) => {}, Err(_) => { return 1; } };
    print_i64(json.position(error));
    1
}
fn main() -> i64 ! {io, alloc, panic} {
    let source = match IO.read_all(IO.stdin(), Bytes.with_capacity(65536)) {
        Ok(source) => source, Err(_) => { return 2; },
    };
    let tree = match json.parse(&source[..]) {
        Ok(value) => value, Err(error) => { return report(error); },
    };
    drop(source);
    let output = match json.stringify(tree) {
        Ok(output) => output, Err(error) => { return report(error); },
    };
    match IO.write(IO.stdout(), &output) { Ok(_) => {}, Err(_) => { return 2; } };
    let newline = Bytes.from("\n");
    match IO.write(IO.stdout(), &newline) { Ok(_) => 0, Err(_) => 2 }
}
