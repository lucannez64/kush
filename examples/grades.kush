// Natural and abstract usage grades.
//
// `twice` promises exactly two uses of its parameter. `four` is abstract in a
// compile-time grade `G` and requires exactly `G * 2` uses; it is instantiated
// explicitly as `four::<2>`, so its parameter grade is four.
fn twice(x: i64 @[2]) -> i64 ! {panic} { x + x }

fn four<G: Grade>(x: i64 @[G * 2]) -> i64 ! {panic} { x + x + x + x }

fn main() -> i64 ! {panic} {
    let a = twice(21); // 42
    let b = four::<2>(10); // 40
    let ghost: i64 @[0] = 7; // compiled, never observed
    a + b - 40
}
