module examples.results;

enum Result<T, E> { Ok(T), Err(E) }
enum ParseError { InvalidDigit(i64), OutOfRange }
enum Option<T> { None, Some(T) }

fn digit(code: i64) -> Result<i64, ParseError> ! {panic} {
    if code >= 48 && code <= 57 {
        Ok(code - 48)
    } else {
        Err(ParseError.InvalidDigit(code))
    }
}

fn parse_two_digits(first: i64, second: i64) -> Result<i64, ParseError> ! {panic} {
    let a = digit(first)?;
    let b = digit(second)?;
    Ok(a * 10 + b)
}

fn report(result: Result<i64, ParseError>) -> Unit ! {io, panic} {
    match result {
        Ok(value) => print_i64(value),
        Err(ParseError.InvalidDigit(code)) => print_i64(code),
        Err(ParseError.OutOfRange) => print_i64(-1),
    }
}

fn main() -> Unit ! {io, panic} {
    report(parse_two_digits(52, 50));
    report(parse_two_digits(65, 50));
    let mut maybe: Option<Result<i64, ParseError>> = Some(Ok(7));
    print_i64(match maybe {
        Some(Ok(value)) => value,
        Some(Err(_)) | None => -1,
    });
    maybe = None;
    print_i64(match maybe { Some(_) => 0, None => 99 });
}
