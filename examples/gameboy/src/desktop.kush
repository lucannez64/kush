module gameboy.desktop;

use std.option.Option;
use std.result.Result;
use std.text;
use media.audio;
use media.audio.Audio;
use media.input.Axis;
use media.input.Button;
use media.input.Event;
use media.input.Key;
use media.window;
use media.window.Window;
use gameboy.apu;
use gameboy.cartridge.Mapper;
use gameboy.emulator;
use gameboy.emulator.Play;
use gameboy.machine;
use gameboy.machine.Machine;

// The desktop front end: a window (through the `media` package, on SDL2),
// sound, keyboard and gamepads.

// Game Boy button bits, as `machine.press` takes them.
const RIGHT: i64 = 0x01;
const LEFT: i64 = 0x02;
const UP: i64 = 0x04;
const DOWN: i64 = 0x08;
const A: i64 = 0x10;
const B: i64 = 0x20;
const SELECT: i64 = 0x40;
const START: i64 = 0x80;

/// A stick must be pushed this far (of 32767) to count as a direction.
const DEADZONE: i64 = 12000;
/// Keep about this many bytes of sound queued: 4 frames, ~67 ms.
const AUDIO_TARGET: i64 = 4 * 800 * 4;
const FRAME_NS: i64 = 16742706;

/// What the player is holding, from every input source.
struct Controls {
    keys: i64,
    pad: i64,
    /// Buttons pressed since the last frame: held for at least that frame,
    /// so a tap shorter than a frame is not lost.
    tapped: i64,
    stick_x: i64,
    stick_y: i64,
    quit: Bool,
}

fn key_bit(key: Key) -> i64 ! {} {
    match key {
        Key.Up => UP, Key.Down => DOWN, Key.Left => LEFT, Key.Right => RIGHT,
        Key.Enter => START, Key.Space => SELECT, Key.Backspace => SELECT,
        Key.Char(c) => match c {
            119 => UP, 97 => LEFT, 115 => DOWN, 100 => RIGHT, // w a s d
            120 => A, 107 => A,                                // x k
            122 => B, 106 => B,                                // z j
            _ => 0,
        },
        _ => 0,
    }
}

/// Buttons laid out like a Nintendo pad: the right face button is A.
fn button_bit(button: Button) -> i64 ! {} {
    match button {
        Button.East => A, Button.North => A,
        Button.South => B, Button.West => B,
        Button.Start => START, Button.Back => SELECT,
        Button.DpadUp => UP, Button.DpadDown => DOWN,
        Button.DpadLeft => LEFT, Button.DpadRight => RIGHT,
        _ => 0,
    }
}

fn held(c: &Controls) -> i64 ! {panic} {
    let mut stick = 0;
    if c.stick_x < 0 - DEADZONE { stick = stick | LEFT; }
    if c.stick_x > DEADZONE { stick = stick | RIGHT; }
    if c.stick_y < 0 - DEADZONE { stick = stick | UP; }
    if c.stick_y > DEADZONE { stick = stick | DOWN; }
    c.keys | c.pad | c.tapped | stick
}

/// Apply every pending window event to the controls.
fn handle_events(win: &Window, c: &mut Controls) -> Unit ! {io, panic} {
    let mut more = true;
    while more {
        match window.next_event(win) {
            Option.None => { more = false; },
            Option.Some(event) => match event {
                Event.Quit => { c.quit = true; },
                Event.KeyDown(Key.Escape) => { c.quit = true; },
                Event.KeyDown(key) => {
                    let bit = key_bit(key);
                    c.keys = c.keys | bit;
                    c.tapped = c.tapped | bit;
                },
                Event.KeyUp(key) => { c.keys = c.keys & (0xFF - key_bit(key)); },
                Event.ButtonDown(_, button) => {
                    let bit = button_bit(button);
                    c.pad = c.pad | bit;
                    c.tapped = c.tapped | bit;
                },
                Event.ButtonUp(_, button) => { c.pad = c.pad & (0xFF - button_bit(button)); },
                Event.AxisMoved(_, Axis.LeftX, value) => { c.stick_x = value; },
                Event.AxisMoved(_, Axis.LeftY, value) => { c.stick_y = value; },
                _ => {},
            },
        }
    }
}

fn controls() -> Controls ! {} {
    Controls { keys: 0, pad: 0, tapped: 0, stick_x: 0, stick_y: 0, quit: false }
}

/// A frame's shades as RGB bytes for the window.
fn pixels(screen: &Bytes) -> Bytes ! {alloc, panic} {
    let mut out = Bytes.with_capacity(screen.len() * 3);
    let mut i = 0;
    while i < screen.len() {
        let (r, g, b) = emulator.rgb(Int.truncate(screen[i]));
        out = out.push(r).push(g).push(b);
        i = i + 1;
    }
    out
}

/// Samples encoded for the audio queue.
fn encode(samples: &Vec<i64>) -> Bytes ! {alloc, panic} {
    let mut out = Bytes.with_capacity(samples.len() * 2);
    let mut i = 0;
    while i < samples.len() {
        out = audio.push(out, samples[i]);
        i = i + 1;
    }
    out
}

fn show_rate(win: &Window, title: &Bytes, rate: i64) -> Unit ! {io, alloc, panic} {
    let mut name = emulator.append(Bytes.from("Kush Game Boy - "), title);
    name = emulator.append(name, &Bytes.from(" - "));
    name = text.format_i64_into(name, rate);
    name = emulator.append(name, &Bytes.from(" fps"));
    let _ = window.set_title(win, &name);
}

/// Open a window and play until it is closed. Fails with ENODEV (19) when
/// there is no display; sound is optional.
///
/// The front end is three handlers around `emulator.run`: `Buttons` reads
/// the window's events, `Present` draws the frame and keeps the frame rate
/// in the title, `Play` queues the sound and paces the game. They share the
/// window and the controls through references the handlers capture.
pub fn play<M: Mapper>(m: &mut Machine<M>, title: &Bytes, scale: i64) -> Result<Unit, i64> ! {io, alloc, panic} {
    let win = window.open(&emulator.append(Bytes.from("Kush Game Boy - "), title), machine.SCREEN_WIDTH, machine.SCREEN_HEIGHT, scale)?;
    // Sound is handled out here, so `session` works the same with or
    // without it: its `emulator.run` performs `Play` and reaches whichever
    // handler is active.
    let result = match audio.open(apu.SAMPLE_RATE, 2) {
        Result.Ok(device) => {
            let speaker = &device;
            let result = handle Play: Vec<i64> -> Unit with fn(
                samples: Vec<i64>,
                resume: linear once fn(Unit) -> Unit ! {},
            ) -> Unit ! {io, alloc, panic} {
                let _ = audio.queue(speaker, &encode(&samples));
                // The audio clock paces the game: wait while more than
                // the target is queued, so sound and picture stay together.
                while audio.queued(speaker) > AUDIO_TARGET {
                    let _ = TIME.sleep_ms(1);
                }
                resume(())
            } {
                session(m, &win, title)
            };
            audio.close(device);
            result
        },
        Result.Err(missing) => {
            // Silent: a 59.7 Hz clock paces the game.
            let mut next = match TIME.monotonic_ns() { Result.Ok(t) => t, Result.Err(_) => 0 };
            handle Play: Vec<i64> -> Unit with fn(
                samples: Vec<i64>,
                resume: linear once fn(Unit) -> Unit ! {},
            ) -> Unit ! {io, panic} {
                next = next + FRAME_NS;
                let now = match TIME.monotonic_ns() { Result.Ok(t) => t, Result.Err(_) => next };
                if next > now {
                    let _ = TIME.sleep_ms((next - now) / 1000000);
                } else if now - next > 100000000 {
                    // More than 100 ms behind: drop the debt rather than race.
                    next = now;
                }
                resume(())
            } {
                session(m, &win, title)
            }
        },
    };
    window.close(win);
    result
}

/// The window's side of the front end: `Buttons` reads the window's events,
/// `Present` draws each frame and keeps the frame rate in the title. The
/// handlers share the window and the controls through references they
/// capture; `Play` is left to the caller.
fn session<M: Mapper>(m: &mut Machine<M>, shown: &Window, title: &Bytes) -> Result<Unit, i64> ! {Play, io, alloc, panic} {
    let mut c = controls();
    let pad = &mut c;
    let mut second = match TIME.monotonic_ns() { Result.Ok(t) => t, Result.Err(_) => 0 };
    let mut frames = 0;
    let mut failure = 0;
    handle Buttons: Unit -> i64 with fn(
        nothing: Unit,
        resume: linear once fn(i64) -> i64 ! {},
    ) -> i64 ! {io, panic} {
        handle_events(shown, pad);
        let buttons = held(pad);
        pad.tapped = 0;
        if pad.quit { resume(-1) } else { resume(buttons) }
    } {
        handle Present: Bytes -> Bool with fn(
            screen: Bytes,
            resume: linear once fn(Bool) -> Bool ! {},
        ) -> Bool ! {io, alloc, panic} {
            match window.present(shown, &pixels(&screen)) {
                Result.Ok(_) => {},
                Result.Err(code) => { failure = code; },
            }
            frames = frames + 1;
            let now = match TIME.monotonic_ns() { Result.Ok(t) => t, Result.Err(_) => second };
            if now - second >= 1000000000 {
                show_rate(shown, title, frames);
                frames = 0;
                second = now;
            }
            resume(failure == 0)
        } {
            emulator.run(m)
        }
    };
    if failure != 0 { Result.Err(failure) } else { Result.Ok(()) }
}
