module gameboy.ppu;

use gameboy.machine;
use gameboy.machine.Machine;

// The picture processing unit. A frame is 154 lines of 456 dots; lines
// 0-143 are visible and each passes through OAM search (mode 2, 80 dots),
// drawing (mode 3, 172 dots) and horizontal blank (mode 0). Lines 144-153 are
// vertical blank (mode 1). A visible line is drawn whole when its drawing
// ends, which is when a DMG has finished reading the registers for it.

const DOTS_PER_LINE: i64 = 456;
const LINES: i64 = 154;
const VISIBLE_LINES: i64 = 144;

// LCDC bits.
const DISPLAY_ON: u8 = 0x80;
const WINDOW_MAP: u8 = 0x40;
const WINDOW_ON: u8 = 0x20;
const UNSIGNED_TILES: u8 = 0x10;
const BACKGROUND_MAP: u8 = 0x08;
const TALL_SPRITES: u8 = 0x04;
const SPRITES_ON: u8 = 0x02;
const BACKGROUND_ON: u8 = 0x01;

fn wide(value: u8) -> i64 ! {} { Int.convert(value) }

/// Advance the display by `cycles` dots.
pub fn advance<M>(m: &mut Machine<M>, cycles: i64) -> Unit ! {panic} {
    if (m.io[0x40] & DISPLAY_ON) == 0 {
        // With the display off the line counter rests at 0 in mode 0.
        m.dot = 0;
        m.window_line = 0;
        m.io[0x44] = 0;
        m.io[0x41] = m.io[0x41] & 0xFC;
        return;
    }
    m.dot = m.dot + cycles;
    if m.dot >= DOTS_PER_LINE {
        m.dot = m.dot - DOTS_PER_LINE;
        next_line(m);
    }
    let line = wide(m.io[0x44]);
    let mode: u8 = if line >= VISIBLE_LINES { 1 } else if m.dot < 80 { 2 } else if m.dot < 252 { 3 } else { 0 };
    let previous = m.io[0x41] & 0x03;
    if mode != previous {
        if previous == 3 { draw_line(m, line); }
        m.io[0x41] = (m.io[0x41] & 0xFC) | mode;
    }
    update_stat(m);
}

fn next_line<M>(m: &mut Machine<M>) -> Unit ! {panic} {
    let mut line = wide(m.io[0x44]) + 1;
    if line == VISIBLE_LINES {
        machine.request(m, machine.VBLANK);
        m.frame_done = true;
    }
    if line == LINES {
        line = 0;
        m.window_line = 0;
    }
    m.io[0x44] = Int.truncate(line);
}

/// The coincidence flag, and the STAT interrupt on a rising edge of any
/// enabled source.
fn update_stat<M>(m: &mut Machine<M>) -> Unit ! {panic} {
    let stat = m.io[0x41];
    let coincidence = m.io[0x44] == m.io[0x45];
    m.io[0x41] = if coincidence { stat | 0x04 } else { stat & 0xFB };
    let mode = stat & 0x03;
    let line = (coincidence && (stat & 0x40) != 0)
        || (mode == 0 && (stat & 0x08) != 0)
        || (mode == 1 && (stat & 0x10) != 0)
        || (mode == 2 && (stat & 0x20) != 0);
    if line && !m.stat_line { machine.request(m, machine.LCD_STAT); }
    m.stat_line = line;
}

/// The colour index (0-3) of pixel `column` (0-7, left to right) of row
/// `row` of the tile whose 16 bytes start at `tile` in VRAM.
fn tile_pixel<M>(m: &Machine<M>, tile: i64, row: i64, column: i64) -> u8 ! {panic} {
    let low = m.vram[tile + row * 2];
    let high = m.vram[tile + row * 2 + 1];
    let bit: u8 = Int.truncate(7 - column);
    (((high >> bit) & 1) << 1) | ((low >> bit) & 1)
}

/// Where a background or window tile's data starts, from its map entry.
fn tile_address(lcdc: u8, entry: u8) -> i64 ! {panic} {
    let index = wide(entry);
    if (lcdc & UNSIGNED_TILES) != 0 {
        index * 16
    } else {
        // Indices 128-255 sit below 0x9000 and 0-127 above it.
        0x1000 + (if index >= 128 { index - 256 } else { index }) * 16
    }
}

fn shade(palette: u8, index: u8) -> u8 ! {panic} {
    (palette >> (index * 2)) & 0x03
}

/// Choose the (at most ten) sprites on this line in OAM order, then order
/// them by drawing priority: smaller X first, then lower OAM index.
fn select_sprites<M>(m: &mut Machine<M>, line: i64, height: i64) -> i64 ! {panic} {
    let mut count = 0;
    let mut index = 0;
    while index < 40 && count < 10 {
        let top = wide(m.oam[index * 4]) - 16;
        if line >= top && line < top + height {
            // Insertion by X; a later sprite at the same X stays behind.
            let x = m.oam[index * 4 + 1];
            let mut at = count;
            while at > 0 && m.oam[wide(m.sprites[at - 1]) * 4 + 1] > x {
                m.sprites[at] = m.sprites[at - 1];
                at = at - 1;
            }
            m.sprites[at] = Int.truncate(index);
            count = count + 1;
        }
        index = index + 1;
    }
    count
}

fn draw_line<M>(m: &mut Machine<M>, line: i64) -> Unit ! {panic} {
    let lcdc = m.io[0x40];
    let scroll_y = wide(m.io[0x42]);
    let scroll_x = wide(m.io[0x43]);
    let window_y = wide(m.io[0x4A]);
    let window_x = wide(m.io[0x4B]) - 7;
    let background = (lcdc & BACKGROUND_ON) != 0;
    let window = background && (lcdc & WINDOW_ON) != 0 && line >= window_y && window_x < 160;
    let background_map = if (lcdc & BACKGROUND_MAP) != 0 { 0x1C00 } else { 0x1800 };
    let window_map = if (lcdc & WINDOW_MAP) != 0 { 0x1C00 } else { 0x1800 };
    let height = if (lcdc & TALL_SPRITES) != 0 { 16 } else { 8 };
    let sprites = if (lcdc & SPRITES_ON) != 0 { select_sprites(m, line, height) } else { 0 };
    let row = line * machine.SCREEN_WIDTH;
    let mut x = 0;
    while x < machine.SCREEN_WIDTH {
        // Background or window colour index; 0 when both are off.
        let mut index: u8 = 0;
        if window && x >= window_x {
            let wx = x - window_x;
            let wy = m.window_line;
            let entry = m.vram[window_map + (wy / 8) * 32 + wx / 8];
            index = tile_pixel(m, tile_address(lcdc, entry), wy % 8, wx % 8);
        } else if background {
            let bx = (x + scroll_x) & 0xFF;
            let by = (line + scroll_y) & 0xFF;
            let entry = m.vram[background_map + (by / 8) * 32 + bx / 8];
            index = tile_pixel(m, tile_address(lcdc, entry), by % 8, bx % 8);
        }
        let mut colour = shade(m.io[0x47], index);
        // The best sprite with an opaque pixel here decides; if it sits
        // behind a non-zero background, the background shows, not a
        // lower-priority sprite.
        let mut s = 0;
        while s < sprites {
            let base = wide(m.sprites[s]) * 4;
            let left = wide(m.oam[base + 1]) - 8;
            if x >= left && x < left + 8 {
                let attributes = m.oam[base + 3];
                let mut row_in = line - (wide(m.oam[base]) - 16);
                if (attributes & 0x40) != 0 { row_in = height - 1 - row_in; }
                let mut column = x - left;
                if (attributes & 0x20) != 0 { column = 7 - column; }
                let mut tile = wide(m.oam[base + 2]);
                if height == 16 { tile = tile & 0xFE; }
                let pixel = tile_pixel(m, tile * 16, row_in, column);
                if pixel != 0 {
                    if (attributes & 0x80) == 0 || index == 0 {
                        let palette = if (attributes & 0x10) != 0 { m.io[0x49] } else { m.io[0x48] };
                        colour = shade(palette, pixel);
                    }
                    s = sprites;
                }
            }
            s = s + 1;
        }
        m.screen[row + x] = colour;
        x = x + 1;
    }
    if window { m.window_line = m.window_line + 1; }
}
