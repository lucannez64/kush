module gameboy;

use std.result.Result;
use std.text;
use gameboy.cartridge;
use gameboy.cartridge.Kind;
use gameboy.cartridge.Mapper;
use gameboy.emulator;
use gameboy.machine;
use gameboy.desktop;
use gameboy.machine.Machine;
use gameboy.terminal;

// gameboy ROM [--scale N] [--fullscreen]   play in a window, with sound
// gameboy ROM --terminal                   play in the terminal
// gameboy ROM FRAMES [SCREENSHOT.ppm]      run headless
//
// A window starts N times the Game Boy's 160x144 (default 4), can be resized
// freely (the picture keeps its aspect ratio), and F11 switches full screen.
// Games with a battery keep their saves in ROM.sav next to the ROM: loaded
// at start, written when the window or terminal closes.
//
// Headless, the ROM runs for FRAMES frames (about 60 per second of game
// time), whatever it sent to the serial port is printed, and the last frame
// can be saved as an image. Test ROMs report through the serial port, so this
// is also how the emulator is checked. Headless runs never write saves.

/// What the command line asked for.

struct Options {
    /// 0 plays in a window (falling back to the terminal), -1 plays in the
    /// terminal, more runs headless.
    frames: i64,
    screenshot: Bytes,
    scale: i64,
    fullscreen: Bool,
    /// Where battery RAM is kept.
    save: Bytes,
}

fn say(text: &Bytes) -> Unit ! {io, alloc, panic} {
    let _ = IO.write(IO.stdout(), text);
}

fn line(text: Bytes) -> Unit ! {io, alloc, panic} {
    say(&text.push(10));
}

fn argument(index: i64) -> Result<Bytes, i64> ! {io, alloc, panic} {
    ENV.arg(index, Bytes.with_capacity(4096))
}

fn load(path: &Bytes) -> Result<Vec<u8>, i64> ! {io, alloc, panic} {
    let size = FS.size(path)?;
    let bytes = FS.read(path, Bytes.with_capacity(size))?;
    let mut rom: Vec<u8> = Vec.with_capacity(bytes.len());
    let mut i = 0;
    while i < bytes.len() {
        rom = rom.push(Int.truncate(bytes[i]));
        i = i + 1;
    }
    Ok(rom)
}

/// The save file for a ROM: its path with the extension replaced by `.sav`.
fn save_path(rom: &Bytes) -> Bytes ! {alloc, panic} {
    let mut cut = rom.len();
    let mut i = rom.len();
    while i > 0 {
        i = i - 1;
        let c = rom[i];
        if c == 47 { i = 0; } else if c == 46 { cut = i; i = 0; }
    }
    let mut out = Bytes.with_capacity(cut + 4);
    let mut j = 0;
    while j < cut { out = out.push(rom[j]); j = j + 1; }
    emulator.append(out, &Bytes.from(".sav"))
}

/// Load a save into the cartridge, if there is one.
fn load_save<M: Mapper>(board: &mut M, path: &Bytes) -> Unit ! {io, alloc, panic} {
    let size = match FS.size(path) { Ok(n) => n, Err(_) => { return; } };
    match FS.read(path, Bytes.with_capacity(size)) {
        Ok(saved) => board.restore(&saved),
        Err(_) => {},
    }
}

/// Write the cartridge's battery RAM, if it has any.
fn write_save<M: Mapper>(m: &Machine<M>, path: &Bytes) -> Unit ! {io, alloc, panic} {
    let saved = m.cartridge.saved();
    if saved.len() == 0 { return; }
    match FS.write(path, &saved) {
        Ok(_) => {},
        Err(_) => line(Bytes.from("could not write the save file")),
    }
}

fn play<M: Mapper>(board: M, options: &Options, title: &Bytes) -> i64 ! {io, alloc, panic} {
    let mut cartridge = board;
    if options.frames <= 0 { load_save(&mut cartridge, &options.save); }
    let mut m = machine.new(cartridge);
    if options.frames == 0 {
        let shown = desktop.play(&mut m, title, options.scale, options.fullscreen);
        match shown {
            Ok(_) => { write_save(&m, &options.save); return 0; },
            Err(19) => {},
            Err(code) => { write_save(&m, &options.save); return code; },
        }
    }
    if options.frames <= 0 {
        let played = terminal.play(&mut m, title);
        let status = match played {
            Ok(_) => 0,
            Err(code) => {
                line(Bytes.from("the terminal front end needs an interactive terminal"));
                code
            },
        };
        write_save(&m, &options.save);
        return status;
    }
    headless(&mut m, options.frames, &options.screenshot)
}

/// Run `frames` frames, stopping early once a test ROM has reported. The
/// headless front end is three small handlers: the button handler counts
/// frames down, and picture and sound are dropped.
fn headless<M: Mapper>(m: &mut Machine<M>, frames: i64, screenshot: &Bytes) -> i64 ! {io, alloc, panic} {
    let mut frame = 0;
    while frame < frames {
        // Run a second of game time, then look for a test report.
        let chunk = if frames - frame < 60 { frames - frame } else { 60 };
        let mut left = chunk;
        handle Buttons: Unit -> i64 with fn(
            nothing: Unit,
            resume: linear once fn(i64) -> i64 ! {},
        ) -> i64 ! {panic} {
            if left == 0 { resume(-1) } else { left = left - 1; resume(0) }
        } {
            handle Present: Vec<u8> -> (Vec<u8>, Bool) with fn(
                screen: Vec<u8>,
                resume: linear once fn((Vec<u8>, Bool)) -> (Vec<u8>, Bool) ! {},
            ) -> (Vec<u8>, Bool) ! {} { resume((screen, true)) } {
                handle Play: Vec<i64> -> Vec<i64> with fn(
                    samples: Vec<i64>,
                    resume: linear once fn(Vec<i64>) -> Vec<i64> ! {},
                ) -> Vec<i64> ! {} { resume(samples) } {
                    emulator.run(m)
                }
            }
        };
        frame = frame + chunk;
        let output = emulator.serial_text(m);
        if text.contains(&output, &Bytes.from("Passed")) || text.contains(&output, &Bytes.from("Failed")) {
            frame = frames;
        }
        // A cartridge-RAM report is final once its status leaves 0x80.
        if machine.read(m, 0xA001) == 0xDE && machine.read(m, 0xA002) == 0xB0
            && machine.read(m, 0xA003) == 0x61 && machine.read(m, 0xA000) != 0x80 {
            frame = frames;
        }
    }
    let output = emulator.serial_text(m);
    say(&output);
    if output.len() > 0 { line(Bytes.from("")); }
    // Newer Blargg tests also report in cartridge RAM: the signature
    // DE B0 61 at 0xA001, a status at 0xA000 (0 = passed), text at 0xA004.
    if machine.read(m, 0xA001) == 0xDE && machine.read(m, 0xA002) == 0xB0 && machine.read(m, 0xA003) == 0x61 {
        let mut report = Bytes.from("cartridge RAM report, status ");
        report = text.format_i64_into(report, Int.convert(machine.read(m, 0xA000)));
        line(report);
        let mut message = Bytes.with_capacity(256);
        let mut address: u16 = 0xA004;
        while machine.read(m, address) != 0 && address < 0xBFFF {
            message = message.push(Int.convert(machine.read(m, address)));
            address = address + 1;
        }
        line(message);
    }
    if screenshot.len() > 0 {
        let image = emulator.screenshot(m, 1);
        match FS.write(screenshot, &image) {
            Ok(_) => {},
            Err(_) => { line(Bytes.from("could not write the screenshot")); return 1; },
        }
    }
    let mut report = Bytes.from("frames: ");
    report = text.format_i64_into(report, frame);
    report = emulator.append(report, &Bytes.from(", cycles: "));
    report = text.format_i64_into(report, m.cycles);
    line(report);
    0
}

fn same(a: &Bytes, b: &Bytes) -> Bool ! {panic} {
    if a.len() != b.len() { return false; }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    true
}

fn usage() -> i64 ! {io, alloc, panic} {
    line(Bytes.from("usage: gameboy ROM [--scale N] [--fullscreen]  (play in a window, with sound)"));
    line(Bytes.from("       gameboy ROM --terminal                  (play in the terminal)"));
    line(Bytes.from("       gameboy ROM FRAMES [SCREENSHOT.ppm]     (run headless)"));
    2
}

fn main() -> i64 ! {io, alloc, panic} {
    let count = match ENV.arg_count() { Ok(n) => n, Err(_) => 0 };
    if count < 2 { return usage(); }
    let path = match argument(1) { Ok(p) => p, Err(_) => { return 2; } };
    let mut frames = 0;
    let mut screenshot = Bytes.from("");
    let mut scale = 4;
    let mut fullscreen = false;
    let mut positional = 0;
    let mut index = 2;
    while index < count {
        let word = match argument(index) { Ok(w) => w, Err(_) => { return 2; } };
        if same(&word, &Bytes.from("--terminal")) {
            frames = -1;
        } else if same(&word, &Bytes.from("--fullscreen")) {
            fullscreen = true;
        } else if same(&word, &Bytes.from("--scale")) {
            index = index + 1;
            let value = match argument(index) { Ok(v) => v, Err(_) => { return usage(); } };
            scale = match text.parse_i64(&value) {
                Ok(n) => if n >= 1 && n <= 16 { n } else { return usage(); },
                Err(_) => { return usage(); },
            };
        } else if positional == 0 {
            frames = match text.parse_i64(&word) { Ok(n) => n, Err(_) => { return usage(); } };
            positional = 1;
        } else if positional == 1 {
            screenshot = word;
            positional = 2;
        } else {
            return usage();
        }
        index = index + 1;
    }
    let options = Options {
        frames: frames, screenshot: screenshot, scale: scale, fullscreen: fullscreen, save: save_path(&path),
    };
    let rom = match load(&path) {
        Ok(rom) => rom,
        Err(_) => { line(Bytes.from("cannot read the ROM")); return 1; },
    };
    let title = cartridge.title(&rom);
    if options.frames > 0 {
        let mut name = Bytes.from("cartridge: ");
        name = emulator.append(name, &title);
        line(name);
    }
    match cartridge.kind(&rom) {
        Kind.Plain => play(cartridge.plain(&rom), &options, &title),
        Kind.Mbc1 => play(cartridge.mbc1(&rom), &options, &title),
        Kind.Mbc3 => play(cartridge.mbc3(&rom), &options, &title),
        Kind.Mbc5 => play(cartridge.mbc5(&rom), &options, &title),
        Kind.Unsupported(code) => {
            let mut message = Bytes.from("unsupported cartridge type ");
            message = text.format_i64_into(message, Int.convert(code));
            line(message);
            1
        },
    }
}
