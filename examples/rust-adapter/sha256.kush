module rust_adapter_example;
// From this directory: kush bindgen Bridge.toml && kush run
// Kush builds the Cargo staticlib configured in Kush.toml and links it.
// You can also build this single file with explicit --link/--link-lib flags.
//
// Bridge.toml is the source of truth. `kush bindgen` generates both
// src/ffi.rs (Rust extern "C" shims) and src/sha256_adapter.kush (the public
// declarations below). The Rust crate reuses sha2 0.10 through safe Rust
// functions. Generated shims catch panics, map Result errors to status codes,
// and release the opaque Hasher exactly once.
use std.result.Result;
use rust_adapter_example.sha256_adapter;

fn write_line(text: &Bytes) -> Unit ! {io, alloc, panic} {
    match IO.write(IO.stdout(), text) { Ok(_) => (), Err(_) => () };
    match IO.write(IO.stdout(), &Bytes.from("\n")) { Ok(_) => (), Err(_) => () }
}

fn main() -> Unit ! {io, alloc, panic} {
    let input = Bytes.from("abc");
    let direct = match sha256_adapter.sha256(&input) { Ok(value) => value, Err(_) => Bytes.from("") };
    write_line(&direct);

    let streamed = {
        let hasher = sha256_adapter.hasher_new();
        let _ = match sha256_adapter.hasher_update(&hasher, &input) { Ok(n) => n, Err(_) => 0 };
        let part = match sha256_adapter.hasher_update(&hasher, &Bytes.from("")) { Ok(n) => n, Err(_) => 0 };
        let _ = part;
        match sha256_adapter.hasher_finish(&hasher) { Ok(value) => value, Err(_) => Bytes.from("") }
    };
    write_line(&streamed);

    print_i64(sha256_adapter.add(19, 23));
    print_i64(sha256_adapter.live());
    print_i64(match sha256_adapter.fail(&input) { Ok(_) => 0, Err(code) => code });
    write_line(&match sha256_adapter.last_error() { Ok(message) => message, Err(_) => Bytes.from("last_error unavailable") });
    print_i64(match sha256_adapter.boom() { Ok(_) => 0, Err(code) => code });
    write_line(&match sha256_adapter.last_error() { Ok(message) => message, Err(_) => Bytes.from("last_error unavailable") });
}
