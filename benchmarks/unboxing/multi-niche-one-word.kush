fn make(i: i64) -> i64 ! {panic} {
    let r = i % 4;
    if r == 0 { 2 } else { if r == 1 { 3 } else { if r == 2 { 1 } else { 0 } } }
}
fn main() -> i64 ! {alloc, panic} {
    let n = 4000000;
    let mut v: Vec<i64> = Vec.with_capacity(n);
    let mut i = 0;
    while i < n { v = Vec.push(v, make(i)); i = i + 1; }
    let mut acc = 0;
    let mut round = 0;
    while round < 20 {
        let mut j = 0;
        while j < n {
            acc = acc + match Vec.get(&v, j) { 2 => 1, 3 => 2, 1 => 3, _ => 5 };
            j = j + 1;
        }
        round = round + 1;
    }
    acc % 251
}
