enum Code { X(i64), Y(i64), None }
fn make(i: i64) -> Code ! {panic} {
    let r = i % 3;
    if r == 0 { Code.None } else { if r == 1 { Code.X(i) } else { Code.Y(i) } }
}
fn main() -> i64 ! {alloc, panic} {
    let n = 4000000;
    let mut v: Vec<Code> = Vec.with_capacity(n);
    let mut i = 0;
    while i < n { v = Vec.push(v, make(i)); i = i + 1; }
    let mut acc = 0;
    let mut round = 0;
    while round < 20 {
        let mut j = 0;
        while j < n {
            acc = acc + match Vec.get(&v, j) { Code.None => 1, Code.X(a) => a % 7, Code.Y(b) => b % 5 };
            j = j + 1;
        }
        round = round + 1;
    }
    acc % 251
}
