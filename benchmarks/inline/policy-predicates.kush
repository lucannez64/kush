// NATIVE-INLINE benchmark: the VELA client share policy written like the
// Rust crate, with small predicate functions. Prints the checksum and
// picoseconds per decision. `kush build policy-predicates.kush -o p --release`.
use std.result.Result;

struct Facts {
    authenticated: Bool,
    addressed: Bool,
    sender_matches: Bool,
    has_pin: Bool,
    signer_matches: Bool,
    lineage_matches: Bool,
    pinned: u64,
    candidate: u64,
}

enum Decision { First(u64), Update(u64), Reject }

fn bound(f: Facts) -> Bool ! {} {
    f.authenticated && f.addressed && f.sender_matches && f.candidate >= 1
}

fn first_contact(f: Facts) -> Bool ! {} {
    !f.has_pin && bound(f)
}

fn update(f: Facts) -> Bool ! {} {
    f.has_pin && bound(f) && f.signer_matches && f.lineage_matches && f.candidate > f.pinned
}

fn plan(f: Facts) -> Decision ! {} {
    if first_contact(f) {
        Decision.First(f.candidate)
    } else if update(f) {
        Decision.Update(f.candidate)
    } else {
        Decision.Reject
    }
}

fn code(d: Decision) -> i64 ! {panic} {
    match d {
        Decision.First(r) => 8 + Int.truncate(r),
        Decision.Update(r) => 16 + Int.truncate(r),
        Decision.Reject => 0,
    }
}

fn decide(i: i64) -> i64 ! {panic} {
    let x = (i * 2654435761) % 4294967296;
    code(plan(Facts {
        authenticated: (x & 1) == 1,
        addressed: ((x >> 1) & 1) == 1,
        sender_matches: ((x >> 2) & 1) == 1,
        has_pin: ((x >> 3) & 1) == 1,
        signer_matches: ((x >> 4) & 1) == 1,
        lineage_matches: ((x >> 5) & 1) == 1,
        pinned: Int.truncate((x >> 6) & 7),
        candidate: Int.truncate((x >> 9) & 7),
    }))
}

fn now() -> i64 ! {io, panic} {
    match TIME.monotonic_ns() { Result.Ok(ns) => ns, Result.Err(_) => 0 }
}

fn main() -> i64 ! {io, panic} {
    let n = 100000000;
    let t0 = now();
    let mut checksum = 0;
    let mut i = 0;
    while i < n {
        checksum = (checksum + decide(i)) % 1000000007;
        i = i + 1;
    }
    let t1 = now();
    print_i64(checksum);
    print_i64((t1 - t0) * 1000 / n);
    0
}
