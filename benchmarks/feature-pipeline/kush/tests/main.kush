module feature_pipeline.tests.main;
use std.test;
use feature_pipeline.pipeline;

#[test]
fn transforms_are_equivalent_and_ticket_is_consumed() -> Unit ! {io, alloc, panic} {
    test.equal_i64(pipeline.batch(1, true), 46260);
    test.equal_i64(pipeline.batch(1, false), 46260);
    test.equal_i64(pipeline.batch(257, true), pipeline.batch(257, false));
}

#[test]
fn two_use_transform_and_borrowed_checksum_match_values() -> Unit ! {io, alloc, panic} {
    test.equal_i64(pipeline.scrub(65535), 65280);
    let values: Vec<i64> = [1, 2, 3, 4];
    test.equal_i64(pipeline.checksum(&values[..]), 10);
}
