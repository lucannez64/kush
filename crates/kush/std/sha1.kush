    let m52: u32 = w1 ^ w12 ^ w6 ^ w4;
    w4 = ((m52 << 1) | (m52 >> 31));
    c = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(c, ((d << 5) | (d >> 27))), ((e & a) | (e & b) | (a & b))), 0x8f1bbcdc), w4);
    e = ((e << 30) | (e >> 2));
    let m53: u32 = w2 ^ w13 ^ w7 ^ w5;
    w5 = ((m53 << 1) | (m53 >> 31));
    b = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(b, ((c << 5) | (c >> 27))), ((d & e) | (d & a) | (e & a))), 0x8f1bbcdc), w5);
    d = ((d << 30) | (d >> 2));
    let m54: u32 = w3 ^ w14 ^ w8 ^ w6;
    w6 = ((m54 << 1) | (m54 >> 31));
    a = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(a, ((b << 5) | (b >> 27))), ((c & d) | (c & e) | (d & e))), 0x8f1bbcdc), w6);
    c = ((c << 30) | (c >> 2));
    let m55: u32 = w4 ^ w15 ^ w9 ^ w7;
    w7 = ((m55 << 1) | (m55 >> 31));
    e = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(e, ((a << 5) | (a >> 27))), ((b & c) | (b & d) | (c & d))), 0x8f1bbcdc), w7);
    b = ((b << 30) | (b >> 2));
    let m56: u32 = w5 ^ w0 ^ w10 ^ w8;
    w8 = ((m56 << 1) | (m56 >> 31));
    d = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(d, ((e << 5) | (e >> 27))), ((a & b) | (a & c) | (b & c))), 0x8f1bbcdc), w8);
    a = ((a << 30) | (a >> 2));
    let m57: u32 = w6 ^ w1 ^ w11 ^ w9;
    w9 = ((m57 << 1) | (m57 >> 31));
    c = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(c, ((d << 5) | (d >> 27))), ((e & a) | (e & b) | (a & b))), 0x8f1bbcdc), w9);
    e = ((e << 30) | (e >> 2));
    let m58: u32 = w7 ^ w2 ^ w12 ^ w10;
    w10 = ((m58 << 1) | (m58 >> 31));
    b = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(b, ((c << 5) | (c >> 27))), ((d & e) | (d & a) | (e & a))), 0x8f1bbcdc), w10);
    d = ((d << 30) | (d >> 2));
    let m59: u32 = w8 ^ w3 ^ w13 ^ w11;
    w11 = ((m59 << 1) | (m59 >> 31));
    a = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(a, ((b << 5) | (b >> 27))), ((c & d) | (c & e) | (d & e))), 0x8f1bbcdc), w11);
    c = ((c << 30) | (c >> 2));
    let m60: u32 = w9 ^ w4 ^ w14 ^ w12;
    w12 = ((m60 << 1) | (m60 >> 31));
    e = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(e, ((a << 5) | (a >> 27))), (b ^ c ^ d)), 0xca62c1d6), w12);
    b = ((b << 30) | (b >> 2));
    let m61: u32 = w10 ^ w5 ^ w15 ^ w13;
    w13 = ((m61 << 1) | (m61 >> 31));
    d = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(d, ((e << 5) | (e >> 27))), (a ^ b ^ c)), 0xca62c1d6), w13);
    a = ((a << 30) | (a >> 2));
    let m62: u32 = w11 ^ w6 ^ w0 ^ w14;
    w14 = ((m62 << 1) | (m62 >> 31));
    c = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(c, ((d << 5) | (d >> 27))), (e ^ a ^ b)), 0xca62c1d6), w14);
    e = ((e << 30) | (e >> 2));
    let m63: u32 = w12 ^ w7 ^ w1 ^ w15;
    w15 = ((m63 << 1) | (m63 >> 31));
    b = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(b, ((c << 5) | (c >> 27))), (d ^ e ^ a)), 0xca62c1d6), w15);
    d = ((d << 30) | (d >> 2));
    let m64: u32 = w13 ^ w8 ^ w2 ^ w0;
    w0 = ((m64 << 1) | (m64 >> 31));
    a = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(a, ((b << 5) | (b >> 27))), (c ^ d ^ e)), 0xca62c1d6), w0);
    c = ((c << 30) | (c >> 2));
    let m65: u32 = w14 ^ w9 ^ w3 ^ w1;
    w1 = ((m65 << 1) | (m65 >> 31));
    e = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(e, ((a << 5) | (a >> 27))), (b ^ c ^ d)), 0xca62c1d6), w1);
    b = ((b << 30) | (b >> 2));
    let m66: u32 = w15 ^ w10 ^ w4 ^ w2;
    w2 = ((m66 << 1) | (m66 >> 31));
    d = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(d, ((e << 5) | (e >> 27))), (a ^ b ^ c)), 0xca62c1d6), w2);
    a = ((a << 30) | (a >> 2));
    let m67: u32 = w0 ^ w11 ^ w5 ^ w3;
    w3 = ((m67 << 1) | (m67 >> 31));
    c = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(c, ((d << 5) | (d >> 27))), (e ^ a ^ b)), 0xca62c1d6), w3);
    e = ((e << 30) | (e >> 2));
    let m68: u32 = w1 ^ w12 ^ w6 ^ w4;
    w4 = ((m68 << 1) | (m68 >> 31));
    b = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(b, ((c << 5) | (c >> 27))), (d ^ e ^ a)), 0xca62c1d6), w4);
    d = ((d << 30) | (d >> 2));
    let m69: u32 = w2 ^ w13 ^ w7 ^ w5;
    w5 = ((m69 << 1) | (m69 >> 31));
    a = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(a, ((b << 5) | (b >> 27))), (c ^ d ^ e)), 0xca62c1d6), w5);
    c = ((c << 30) | (c >> 2));
    let m70: u32 = w3 ^ w14 ^ w8 ^ w6;
    w6 = ((m70 << 1) | (m70 >> 31));
    e = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(e, ((a << 5) | (a >> 27))), (b ^ c ^ d)), 0xca62c1d6), w6);
    b = ((b << 30) | (b >> 2));
    let m71: u32 = w4 ^ w15 ^ w9 ^ w7;
    w7 = ((m71 << 1) | (m71 >> 31));
    d = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(d, ((e << 5) | (e >> 27))), (a ^ b ^ c)), 0xca62c1d6), w7);
    a = ((a << 30) | (a >> 2));
    let m72: u32 = w5 ^ w0 ^ w10 ^ w8;
    w8 = ((m72 << 1) | (m72 >> 31));
    c = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(c, ((d << 5) | (d >> 27))), (e ^ a ^ b)), 0xca62c1d6), w8);
    e = ((e << 30) | (e >> 2));
    let m73: u32 = w6 ^ w1 ^ w11 ^ w9;
    w9 = ((m73 << 1) | (m73 >> 31));
    b = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(b, ((c << 5) | (c >> 27))), (d ^ e ^ a)), 0xca62c1d6), w9);
    d = ((d << 30) | (d >> 2));
