module std.sha1;

// SHA-1 (FIPS 180-4) over byte strings (WEB-CRYPTO). SHA-1 is broken for
// collision resistance: use it only where a protocol requires it, such as the
// WebSocket handshake (RFC 6455). Use std.sha256 for anything else.
//
//     let d = sha1.digest(&data);              // 20 bytes
//
// The incremental form is the same as std.sha256: `new`, `update`, `finish`.
// Proofs are the same too: `compress` has an empty effect row, every read,
// shift and index sum is proved, and a block allocates nothing. The eighty
// rounds are unrolled by scripts/gen-sha-rounds.py.

use std.cpu;
use std.x86;
use std.option.Option;
use std.simd.u32x4;

/// Five state words.
type Words = (u32, u32, u32, u32, u32);

/// A hash in progress: the state, the bytes of a partial block (fewer than
/// 64), and the number of bytes hashed so far (modulo 2^64).
pub struct Hasher {
    state: Words,
    block: Bytes,
    length: u64,
}

fn add(a: u32, b: u32) -> u32 ! {} {
    Int.wrapping_add(a, b)
}

/// The big-endian word at data[at..at + 4].
/// `n` is `Bytes.len(data)`: an `i64` local of the caller carries the range
/// that keeps `at + 3` from overflowing, which a length term alone does not.
fn word(
    data: &Bytes,
    n: i64,
    at: i64,
    erased q: { 0 <= at && at + 4 <= n && n == Bytes.len(data) },
) -> u32 ! {} {
    let b0: u32 = Int.truncate(Bytes.at(data, at, _));
    let b1: u32 = Int.truncate(Bytes.at(data, at + 1, _));
    let b2: u32 = Int.truncate(Bytes.at(data, at + 2, _));
    let b3: u32 = Int.truncate(Bytes.at(data, at + 3, _));
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

/// Process the 64-byte block at data[at..at + 64]: the new state.
fn compress(
    state: Words,
    data: &Bytes,
    n: i64,
    at: i64,
    erased q: { 0 <= at && at + 64 <= n && n == Bytes.len(data) },
