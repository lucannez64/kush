    b = ((b << 30) | (b >> 2));
    let m76: u32 = w9 ^ w4 ^ w14 ^ w12;
    w12 = ((m76 << 1) | (m76 >> 31));
    d = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(d, ((e << 5) | (e >> 27))), (a ^ b ^ c)), 0xca62c1d6), w12);
    a = ((a << 30) | (a >> 2));
    let m77: u32 = w10 ^ w5 ^ w15 ^ w13;
    w13 = ((m77 << 1) | (m77 >> 31));
    c = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(c, ((d << 5) | (d >> 27))), (e ^ a ^ b)), 0xca62c1d6), w13);
    e = ((e << 30) | (e >> 2));
    let m78: u32 = w11 ^ w6 ^ w0 ^ w14;
    w14 = ((m78 << 1) | (m78 >> 31));
    b = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(b, ((c << 5) | (c >> 27))), (d ^ e ^ a)), 0xca62c1d6), w14);
    d = ((d << 30) | (d >> 2));
    let m79: u32 = w12 ^ w7 ^ w1 ^ w15;
    w15 = ((m79 << 1) | (m79 >> 31));
    a = Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(Int.wrapping_add::<u32>(a, ((b << 5) | (b >> 27))), (c ^ d ^ e)), 0xca62c1d6), w15);
    c = ((c << 30) | (c >> 2));
    // END GENERATED rounds
    (add(s0, a), add(s1, b), add(s2, c), add(s3, d), add(s4, e))
