    let mut w0 = word(data, n, at, _);
    let mut w1 = word(data, n, at + 4, _);
    let mut w2 = word(data, n, at + 8, _);
    let mut w3 = word(data, n, at + 12, _);
    let mut w4 = word(data, n, at + 16, _);
    let mut w5 = word(data, n, at + 20, _);
    let mut w6 = word(data, n, at + 24, _);
    let mut w7 = word(data, n, at + 28, _);
    let mut w8 = word(data, n, at + 32, _);
    let mut w9 = word(data, n, at + 36, _);
    let mut w10 = word(data, n, at + 40, _);
    let mut w11 = word(data, n, at + 44, _);
    let mut w12 = word(data, n, at + 48, _);
    let mut w13 = word(data, n, at + 52, _);
    let mut w14 = word(data, n, at + 56, _);
    let mut w15 = word(data, n, at + 60, _);
    let (s0, s1, s2, s3, s4) = state;
    let mut a = s0;
    let mut b = s1;
    let mut c = s2;
    let mut d = s3;
