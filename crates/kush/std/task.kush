module std.task;

/// The typed result of joining a structured task. `Completed` carries the
/// task's normal result; `Cancelled` means the task observed a cancellation
/// request and returned through its cleanup path.

pub enum TaskExit<T> { Completed(T), Cancelled }

/// A panic that `Task.catch` stopped (PANIC-UNWIND-USE,
/// docs/panic-unwinding.md). The panic's message went to standard error;
/// everything the unwound code owned was freed on the way.
pub struct Panic {}
