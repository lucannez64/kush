module std.hmac;

// HMAC-SHA256 (RFC 2104, FIPS 198-1) for signed cookies and tokens
// (WEB-CRYPTO).
//
//     let tag = hmac.sign(&key, &message);               // 32 bytes
//     if hmac.verify(&key, &message, &tag) { .. }        // constant time
//
// Compare tags with `verify` (or std.ct.equal), never with a byte
// loop that stops at the first difference.

use std.sha256;
use std.ct;

/// The key padded to one 64-byte block and xored with `fill` (0x36 for the
/// inner hash, 0x5c for the outer one). Keys longer than a block are hashed
/// first, as the standard requires.
fn padded(key: &Bytes, fill: i64) -> Bytes ! {alloc, panic} {
    let hashed = if Bytes.len(key) > 64 { sha256.digest(key) } else { Bytes.copy(key) };
    let mut out = Bytes.with_capacity(64);
    let mut i = 0;
    while i < 64 invariant { 0 <= i } {
        let byte = if i < Bytes.len(&hashed) { Bytes.at(&hashed, i, _) } else { 0 };
        out = Bytes.push(out, byte ^ fill);
        i = i + 1;
    }
    drop(hashed);
    out
}

/// The 32-byte HMAC-SHA256 of `message` under `key`.
pub fn sign(key: &Bytes, message: &Bytes) -> Bytes ! {alloc, panic} {
    let inner_key = padded(key, 54);
    let outer_key = padded(key, 92);
    let mut inner = sha256.new();
    inner = sha256.update(inner, &inner_key);
    inner = sha256.update(inner, message);
    let inner_digest = sha256.finish(inner);
    let mut outer = sha256.new();
    outer = sha256.update(outer, &outer_key);
    outer = sha256.update(outer, &inner_digest);
    drop(inner_key);
    drop(outer_key);
    drop(inner_digest);
    sha256.finish(outer)
}

/// Whether `tag` is the HMAC-SHA256 of `message` under `key`, compared in
/// constant time.
pub fn verify(key: &Bytes, message: &Bytes, tag: &Bytes) -> Bool ! {alloc, panic} {
    let expected = sign(key, message);
    let same = ct.equal(&expected, tag);
    drop(expected);
    same
}
