module std.sys;

// Thin Linux system calls for the rest of std (STD-SYS-FOREIGN). Each
// function is one call into a `kush_sys_*` runtime stub: it returns the
// positive errno as `Err`, including EINTR, so retry and looping policy is
// ordinary Kush code in the modules built on top. Only std may import
// `kush_sys_*` symbols; programs use std.file and the other safe modules.

use std.result.Result;

pub fn EINTR() -> i64 ! {} { 4 }

// open(2) flags (x86-64 Linux). O_CLOEXEC is always added by the stub.
pub fn O_RDONLY() -> i64 ! {} { 0 }
pub fn O_WRONLY() -> i64 ! {} { 1 }
pub fn O_RDWR() -> i64 ! {} { 2 }
pub fn O_CREAT() -> i64 ! {} { 64 }
pub fn O_EXCL() -> i64 ! {} { 128 }
pub fn O_TRUNC() -> i64 ! {} { 512 }
pub fn O_APPEND() -> i64 ! {} { 1024 }
pub fn O_DIRECTORY() -> i64 ! {} { 65536 }

// st_mode file-type bits.
pub fn S_IFMT() -> i64 ! {} { 61440 }
pub fn S_IFREG() -> i64 ! {} { 32768 }
pub fn S_IFDIR() -> i64 ! {} { 16384 }

/// openat(AT_FDCWD, path, flags | O_CLOEXEC, mode); the new descriptor.
pub foreign "kush_sys_openat" fn openat(path: &Bytes, flags: i64, mode: i64) -> Result<i64, i64> ! {io};
/// close(2). Linux always releases the descriptor, so EINTR is success.
pub foreign "kush_sys_close" fn close(fd: i64) -> Result<Unit, i64> ! {io};
pub foreign "kush_sys_fsync" fn fsync(fd: i64) -> Result<Unit, i64> ! {io};
pub foreign "kush_sys_ftruncate" fn ftruncate(fd: i64, length: i64) -> Result<Unit, i64> ! {io};
/// fstat(2) st_size.
pub foreign "kush_sys_fstat_size" fn fstat_size(fd: i64) -> Result<i64, i64> ! {io};
/// One write of data[start..] at `offset` (pwrite), or at the file position
/// when `offset` is negative (write). Returns the count, which may be short.
pub foreign "kush_sys_write" fn write(fd: i64, data: &Bytes, start: i64, offset: i64) -> Result<i64, i64> ! {io};
pub foreign "kush_sys_unlink" fn unlink(path: &Bytes) -> Result<Unit, i64> ! {io};
pub foreign "kush_sys_mkdir" fn mkdir(path: &Bytes, mode: i64) -> Result<Unit, i64> ! {io};
pub foreign "kush_sys_rmdir" fn rmdir(path: &Bytes) -> Result<Unit, i64> ! {io};
pub foreign "kush_sys_rename" fn rename(from: &Bytes, to: &Bytes) -> Result<Unit, i64> ! {io};
/// stat(2) one field: 0 = st_mode, 1 = st_size.
pub foreign "kush_sys_stat" fn stat(path: &Bytes, field: i64) -> Result<i64, i64> ! {io};
/// One read of up to `length` bytes into `buffer`'s spare capacity, at
/// `offset` (pread) or at the file position when `offset` is negative. The
/// buffer comes back with its length advanced (unchanged at end of file), or
/// is freed on failure; EINTR is retried inside, since a failed call loses
/// the buffer. EFBIG when the buffer lacks room for `length` more bytes.
pub foreign "kush_sys_read" fn read(fd: i64, buffer: Bytes, length: i64, offset: i64) -> Result<Bytes, i64> ! {io};
/// Read and discard up to one byte at the file position; 0 at end of file.
pub foreign "kush_sys_probe" fn probe(fd: i64) -> Result<i64, i64> ! {io};
/// opendir(3); the handle is only valid for readdir and closedir.
pub foreign "kush_sys_opendir" fn opendir(path: &Bytes) -> Result<i64, i64> ! {io};
/// Append the next entry name and a newline, skipping "." and "..". At the
/// end the buffer comes back unchanged; EFBIG (and freed) when it is full.
pub foreign "kush_sys_readdir" fn readdir(dir: i64, buffer: Bytes) -> Result<Bytes, i64> ! {io};
pub foreign "kush_sys_closedir" fn closedir(dir: i64) -> Result<Unit, i64> ! {io};
/// Number of process arguments, including argv[0].
pub foreign "kush_sys_argc" fn argc() -> Result<i64, i64> ! {io};
/// Append argv[index]; ENOENT (2) out of range, EFBIG (27) when full.
pub foreign "kush_sys_argv" fn argv(index: i64, buffer: Bytes) -> Result<Bytes, i64> ! {io};
/// Number of NAME=VALUE environment entries.
pub foreign "kush_sys_environ_count" fn environ_count() -> Result<i64, i64> ! {io};
/// getenv(3), appending the value; ENOENT (2) when unset.
pub foreign "kush_sys_getenv" fn getenv(name: &Bytes, buffer: Bytes) -> Result<Bytes, i64> ! {io};
/// clock_gettime(2): clock 0 = realtime, 1 = monotonic; field 0 = seconds,
/// 1 = nanoseconds (EOVERFLOW, 75, when it does not fit).
pub foreign "kush_sys_clock_gettime" fn clock_gettime(clock: i64, field: i64) -> Result<i64, i64> ! {io};
/// Sleep `milliseconds` (>= 0), resuming after EINTR with the time left.
pub foreign "kush_sys_nanosleep" fn nanosleep(milliseconds: i64) -> Result<Unit, i64> ! {io};
/// strerror(3) text for 0 <= code <= 4095 (EINVAL otherwise), appended.
pub foreign "kush_sys_strerror" fn strerror(code: i64, buffer: Bytes) -> Result<Bytes, i64> ! {io};
/// The standard input descriptor (0). A call rather than a constant, so the
/// reference evaluator knows the program reads standard input.
pub foreign "kush_sys_stdin" fn stdin() -> Result<i64, i64> ! {io};
