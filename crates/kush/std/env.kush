module std.env;

// Process arguments and environment variables (STD-ENV-IN-KUSH), over
// `std.sys`. Same signatures and errno results as the `ENV.*` builtins.
// argv[0] is the executable path, so application arguments start at 1.

use std.result.Result;
use std.sys;

pub fn arg_count() -> Result<i64, i64> ! {io} { sys.argc() }

/// Append argument `index` to `buffer`; ENOENT (2) out of range.
pub fn arg(index: i64, buffer: Bytes) -> Result<Bytes, i64> ! {io} { sys.argv(index, buffer) }

pub fn var_count() -> Result<i64, i64> ! {io} { sys.environ_count() }

/// Append the value of variable `name`; ENOENT (2) when unset.
pub fn var(name: &Bytes, buffer: Bytes) -> Result<Bytes, i64> ! {io} { sys.getenv(name, buffer) }
