    s0 = x86.sha256rnds2(sha, s0, s1, swap_halves(wk10));
    let t10 = align4(m2, m1);
    m3 = x86.sha256msg2(sha, u32x4.wrapping_add(m3, t10), m2);
    m1 = x86.sha256msg1(sha, m1, m2);
    let wk11 = u32x4.wrapping_add(m3, u32x4.new(0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070));
    s1 = x86.sha256rnds2(sha, s1, s0, wk11);
    s0 = x86.sha256rnds2(sha, s0, s1, swap_halves(wk11));
    let t11 = align4(m3, m2);
    m0 = x86.sha256msg2(sha, u32x4.wrapping_add(m0, t11), m3);
    m2 = x86.sha256msg1(sha, m2, m3);
    let wk12 = u32x4.wrapping_add(m0, u32x4.new(0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5));
    s1 = x86.sha256rnds2(sha, s1, s0, wk12);
    s0 = x86.sha256rnds2(sha, s0, s1, swap_halves(wk12));
    let t12 = align4(m0, m3);
    m1 = x86.sha256msg2(sha, u32x4.wrapping_add(m1, t12), m0);
    m3 = x86.sha256msg1(sha, m3, m0);
    let wk13 = u32x4.wrapping_add(m1, u32x4.new(0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3));
    s1 = x86.sha256rnds2(sha, s1, s0, wk13);
    s0 = x86.sha256rnds2(sha, s0, s1, swap_halves(wk13));
    let t13 = align4(m1, m0);
    m2 = x86.sha256msg2(sha, u32x4.wrapping_add(m2, t13), m1);
    let wk14 = u32x4.wrapping_add(m2, u32x4.new(0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208));
    s1 = x86.sha256rnds2(sha, s1, s0, wk14);
    s0 = x86.sha256rnds2(sha, s0, s1, swap_halves(wk14));
    let t14 = align4(m2, m1);
    m3 = x86.sha256msg2(sha, u32x4.wrapping_add(m3, t14), m2);
    let wk15 = u32x4.wrapping_add(m3, u32x4.new(0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2));
    s1 = x86.sha256rnds2(sha, s1, s0, wk15);
    s0 = x86.sha256rnds2(sha, s0, s1, swap_halves(wk15));
    // END GENERATED ni-rounds
    let s0 = u32x4.wrapping_add(s0, abef);
    let s1 = u32x4.wrapping_add(s1, cdgh);
    (u32x4.lane(s0, 3, _), u32x4.lane(s0, 2, _), u32x4.lane(s1, 3, _), u32x4.lane(s1, 2, _),
     u32x4.lane(s0, 1, _), u32x4.lane(s0, 0, _), u32x4.lane(s1, 1, _), u32x4.lane(s1, 0, _))
}

/// One block with the SHA instructions when the CPU has them.
fn compress_any(
    fast: Option<cpu.Sha>,
    state: Words,
    data: &Bytes,
    n: i64,
    at: i64,
    erased q: { 0 <= at && at + 64 <= n && n == Bytes.len(data) },
) -> Words {
    match fast {
        Option.Some(sha) => compress_ni(&sha, state, data, n, at, _),
        Option.None => compress(state, data, n, at, _),
    }
}

/// An empty hash.
pub fn new() -> Hasher ! {alloc} {
    Hasher {
        state: (0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
                0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19),
        block: Bytes.with_capacity(64),
        length: 0,
    }
}

/// Hash `data` after everything given so far.
pub fn update(hasher: Hasher, data: &Bytes) -> Hasher ! {alloc} {
    let Hasher { state, block, length } = hasher;
    let fast = cpu.sha();
    let mut state = state;
    let mut block = block;
    let n = Bytes.len(data);
    let added: u64 = Int.truncate(n);
    let length: u64 = Int.wrapping_add(length, added);
    let mut i = 0;
    // Top up a partial block first (no loop when there is none).
    while i < n && Bytes.len(&block) > 0 && Bytes.len(&block) < 64 invariant { 0 <= i && i <= n } {
        block = Bytes.push(block, Bytes.at(data, i, _));
        i = i + 1;
    }
    if Bytes.len(&block) == 64 {
        state = compress_any(fast, state, &block, 64, 0, _);
        drop(block);
        block = Bytes.with_capacity(64);
    }
    // Whole blocks straight from the input.
    while n - i >= 64 invariant { 0 <= i && i <= n } {
        state = compress_any(fast, state, data, n, i, _);
        i = i + 64;
    }
    // Keep the tail for the next call.
    while i < n invariant { 0 <= i } {
        block = Bytes.push(block, Bytes.at(data, i, _));
        i = i + 1;
    }
    Hasher { state: state, block: block, length: length }
}

fn push_word(out: Bytes, v: u32) -> Bytes {
    let out = Bytes.push(out, Int.convert(v >> 24));
    let out = Bytes.push(out, Int.convert((v >> 16) & 255));
    let out = Bytes.push(out, Int.convert((v >> 8) & 255));
    Bytes.push(out, Int.convert(v & 255))
}

/// The 32-byte digest of everything given.
pub fn finish(hasher: Hasher) -> Bytes ! {alloc} {
    // Padding: 0x80, zeros up to 56 mod 64, then the bit length (big-endian).
    let bits: u64 = Int.wrapping_mul(hasher.length, 8);
    let pending = Bytes.len(&hasher.block);
    // A partial block holds 0 to 63 bytes; the bounds are spelled out so the
    // subtractions are proved (the last case cannot happen).
    let zeros = if pending >= 0 && pending < 56 {
        55 - pending
    } else if pending >= 56 && pending < 120 {
        119 - pending
    } else {
        0
    };
    let mut pad = Bytes.with_capacity(72);
    pad = Bytes.push(pad, 128);
    let mut i = 0;
    while i < zeros {
        pad = Bytes.push(pad, 0);
        i = i + 1;
    }
    let mut j = 0;
    while j < 8 invariant { 0 <= j } {
        let byte: i64 = Int.truncate((bits >> (56 - 8 * j)) & 255);
        pad = Bytes.push(pad, byte);
        j = j + 1;
    }
    let hasher = update(hasher, &pad);
    drop(pad);
    let Hasher { state, block, length } = hasher;
    drop(block);
    let (s0, s1, s2, s3, s4, s5, s6, s7) = state;
    let mut out = Bytes.with_capacity(32);
    out = push_word(out, s0);
    out = push_word(out, s1);
    out = push_word(out, s2);
    out = push_word(out, s3);
    out = push_word(out, s4);
    out = push_word(out, s5);
    out = push_word(out, s6);
    out = push_word(out, s7);
    out
}

/// The 32-byte SHA-256 digest of `data`.
pub fn digest(data: &Bytes) -> Bytes ! {alloc} {
    finish(update(new(), data))
}
