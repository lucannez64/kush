module std.sha256;

// SHA-256 (FIPS 180-4) over byte strings (WEB-CRYPTO). One call:
//
//     let d = sha256.digest(&data);            // 32 bytes
//
// or in pieces, for data that arrives in parts (std.hmac uses this):
//
//     let mut h = sha256.new();
//     h = sha256.update(h, &first);
//     h = sha256.update(h, &second);
//     let d = sha256.finish(h);
//
// Proofs: `compress` has an empty effect row, so the checker has proved it
// cannot panic. Every byte read (`Bytes.at`) is proved in bounds by its
// precondition, every shift amount is proved below
// the width (SHIFT-ELIDE), every index sum is proved not to overflow, and
// the additions of the algorithm are modulo 2^32 (`Int.wrapping_add`), as
// the standard defines them. The 64 rounds are unrolled with literal
// constants (generated by scripts/gen-sha-rounds.py), the message schedule
// is a ring of sixteen local words, and a block allocates nothing.

use std.cpu;
use std.x86;
use std.option.Option;
use std.simd.u32x4;

/// Eight state words.
type Words = (u32, u32, u32, u32, u32, u32, u32, u32);

/// A hash in progress: the state, the bytes of a partial block (fewer than
/// 64), and the number of bytes hashed so far (modulo 2^64, as the
/// standard's length field).
pub struct Hasher {
    state: Words,
    block: Bytes,
    length: u64,
}

fn add(a: u32, b: u32) -> u32 {
    Int.wrapping_add(a, b)
}

/// The big-endian word at data[at..at + 4].
/// `n` is `Bytes.len(data)`: an `i64` local of the caller carries the range
/// that keeps `at + 3` from overflowing, which a length term alone does not.
fn word(
    data: &Bytes,
    n: i64,
    at: i64,
    erased q: { 0 <= at && at + 4 <= n && n == Bytes.len(data) },
) -> u32 {
    let b0: u32 = Int.truncate(Bytes.at(data, at, _));
    let b1: u32 = Int.truncate(Bytes.at(data, at + 1, _));
    let b2: u32 = Int.truncate(Bytes.at(data, at + 2, _));
    let b3: u32 = Int.truncate(Bytes.at(data, at + 3, _));
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

