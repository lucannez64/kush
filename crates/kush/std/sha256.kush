/// The vector with its two 64-bit halves swapped: lanes 2, 3 in 0, 1, which
/// is all the second `sha256rnds2` of a group reads. Word moves, not a
/// shuffle, so the x86-64 baseline (no SSSE3) needs no byte-shuffle call.
fn swap_halves(v: u32x4) -> u32x4 {
    let (w0, w1) = u32x4.to_bits(v);
    u32x4.from_bits((w1, w0))
}

/// Lanes 1, 2, 3 of `lo` then lane 0 of `hi` (x86 `palignr hi, lo, 4`).
fn align4(hi: u32x4, lo: u32x4) -> u32x4 {
    let (l0, l1) = u32x4.to_bits(lo);
    let (h0, h1) = u32x4.to_bits(hi);
    u32x4.from_bits(((l0 >> 32) | (l1 << 32), (l1 >> 32) | (h0 << 32)))
}

/// The same block on the CPU's SHA instructions (SHA-NI-STD): Intel's
