    s0 = x86.sha256rnds2(sha, s0, s1, swap_halves(wk2));
    m1 = x86.sha256msg1(sha, m1, m2);
    let wk3 = u32x4.wrapping_add(m3, u32x4.new(0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174));
