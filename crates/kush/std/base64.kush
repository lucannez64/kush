module std.base64;

// Base64 (RFC 4648) in two alphabets (WEB-CRYPTO):
//
//     base64.encode(&data)        // standard: A-Z a-z 0-9 + /, '=' padding
//     base64.encode_url(&data)    // URL and file safe: - _ , no padding
//     base64.decode(&text)        // Option<Bytes>
//     base64.decode_url(&text)    // Option<Bytes>
//
// Decoding is strict and canonical: a character outside the alphabet, a
// missing or misplaced '=' (standard), any '=' (URL form), an impossible
// length, or nonzero unused bits in the last character is `None`. So each
// byte string has exactly one accepted encoding, which matters when decoded
// tokens are compared or used as keys.
//
// Proofs: every byte read is `Bytes.at`, proved in bounds; every shift amount
// and index sum is proved; `symbol` and `value` have empty effect rows.

use std.option.Option;

/// The character for a 6-bit value.
fn symbol(value: i64, url: Bool, erased q: { 0 <= value && value <= 63 }) -> i64 ! {} {
    if value < 26 {
        65 + value
    } else if value < 52 {
        97 + value - 26
    } else if value < 62 {
        48 + value - 52
    } else if value == 62 {
        if url { 45 } else { 43 }
    } else {
        if url { 95 } else { 47 }
    }
}

/// The 6-bit value of a character, or -1 if it is not in the alphabet.
fn value(c: i64, url: Bool) -> i64 ! {} {
    if c >= 65 && c <= 90 {
        c - 65
    } else if c >= 97 && c <= 122 {
        c - 97 + 26
    } else if c >= 48 && c <= 57 {
        c - 48 + 52
    } else if url && c == 45 {
        62
    } else if url && c == 95 {
        63
    } else if !url && c == 43 {
        62
    } else if !url && c == 47 {
        63
    } else {
        -1
    }
}

fn encode_with(data: &Bytes, url: Bool) -> Bytes ! {alloc, panic} {
    let n = Bytes.len(data);
    // 4/3 of the input rounded up fits in 2n + 4; an absurdly large input
    // starts smaller and the buffer grows.
    let capacity = if n < 1152921504606846976 { 2 * n + 4 } else { n };
    let mut out = Bytes.with_capacity(capacity);
    let mut i = 0;
    while n - i >= 3 invariant { 0 <= i && i <= n } {
        let triple = (Bytes.at(data, i, _) << 16) | (Bytes.at(data, i + 1, _) << 8) | Bytes.at(data, i + 2, _);
        out = Bytes.push(out, symbol((triple >> 18) & 63, url, _));
        out = Bytes.push(out, symbol((triple >> 12) & 63, url, _));
        out = Bytes.push(out, symbol((triple >> 6) & 63, url, _));
        out = Bytes.push(out, symbol(triple & 63, url, _));
        i = i + 3;
    }
    let rest = n - i;
    if rest == 1 {
        let triple = Bytes.at(data, i, _) << 16;
        out = Bytes.push(out, symbol((triple >> 18) & 63, url, _));
        out = Bytes.push(out, symbol((triple >> 12) & 63, url, _));
        if !url {
            out = Bytes.push(out, 61);
            out = Bytes.push(out, 61);
        }
    } else if rest == 2 {
        let triple = (Bytes.at(data, i, _) << 16) | (Bytes.at(data, i + 1, _) << 8);
        out = Bytes.push(out, symbol((triple >> 18) & 63, url, _));
        out = Bytes.push(out, symbol((triple >> 12) & 63, url, _));
        out = Bytes.push(out, symbol((triple >> 6) & 63, url, _));
        if !url {
            out = Bytes.push(out, 61);
        }
    }
    out
}

/// Standard Base64 with '=' padding.
pub fn encode(data: &Bytes) -> Bytes ! {alloc, panic} {
    encode_with(data, false)
}

/// Base64url without padding, for URLs, cookies and tokens.
pub fn encode_url(data: &Bytes) -> Bytes ! {alloc, panic} {
    encode_with(data, true)
}

/// Decode the first `count` characters of `text` (no padding among them);
/// `None` on a character outside the alphabet, a length of 1 mod 4, or
/// nonzero unused bits.
fn decode_with(
    text: &Bytes,
    count: i64,
    url: Bool,
    erased q: { 0 <= count && count <= Bytes.len(text) },
) -> Option<Bytes> ! {alloc, panic} {
    // 3/4 of the characters fit in `count` bytes.
    let mut out = Bytes.with_capacity(count);
    let mut i = 0;
    // Whole groups: four characters, three bytes. `value` is -1 outside the
    // alphabet and 0..63 inside, so one sign test covers all four.
    while count - i >= 4 invariant { 0 <= i && i <= count } {
        let a = value(Bytes.at(text, i, _), url);
        let b = value(Bytes.at(text, i + 1, _), url);
        let c = value(Bytes.at(text, i + 2, _), url);
        let d = value(Bytes.at(text, i + 3, _), url);
        if (a | b | c | d) < 0 {
            drop(out);
            return Option.None;
        }
        let group = (a << 18) | (b << 12) | (c << 6) | d;
        out = Bytes.push(out, (group >> 16) & 255);
        out = Bytes.push(out, (group >> 8) & 255);
        out = Bytes.push(out, group & 255);
        i = i + 4;
    }
    // The tail: two characters are one byte, three are two; one character
    // carries only 6 bits and is never valid. The unused low bits of the last
    // character must be zero (canonical form).
    let rest = count - i;
    if rest == 1 {
        drop(out);
        return Option.None;
    }
    if rest == 2 {
        let a = value(Bytes.at(text, i, _), url);
        let b = value(Bytes.at(text, i + 1, _), url);
        if (a | b) < 0 || (b & 15) != 0 {
            drop(out);
            return Option.None;
        }
        out = Bytes.push(out, ((a << 2) | (b >> 4)) & 255);
    } else if rest == 3 {
        let a = value(Bytes.at(text, i, _), url);
        let b = value(Bytes.at(text, i + 1, _), url);
        let c = value(Bytes.at(text, i + 2, _), url);
        if (a | b | c) < 0 || (c & 3) != 0 {
            drop(out);
            return Option.None;
        }
        out = Bytes.push(out, ((a << 2) | (b >> 4)) & 255);
        out = Bytes.push(out, (((b & 15) << 4) | (c >> 2)) & 255);
    }
    Option.Some(out)
}

/// Decode standard Base64. The length must be a multiple of 4, with one or
/// two '=' only at the very end.
pub fn decode(text: &Bytes) -> Option<Bytes> ! {alloc, panic} {
    let n = Bytes.len(text);
    if (n & 3) != 0 {
        return Option.None;
    }
    // Strip one or two final '='. A '=' anywhere else is outside the
    // alphabet, so decode_with rejects it.
    if n > 1 && Bytes.at(text, n - 1, _) == 61 {
        if Bytes.at(text, n - 2, _) == 61 {
            decode_with(text, n - 2, false, _)
        } else {
            decode_with(text, n - 1, false, _)
        }
    } else {
        decode_with(text, n, false, _)
    }
}

/// Decode Base64url without padding.
pub fn decode_url(text: &Bytes) -> Option<Bytes> ! {alloc, panic} {
    decode_with(text, Bytes.len(text), true, _)
}
