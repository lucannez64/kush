module std.natural;

// Arbitrary-precision natural numbers (STD-BIGNAT), the representation the
// logical kernel uses for numerals (`crates/kush/src/natural.rs`), so a
// kernel written in Kush can read, compare and print the same literals.
//
// Little-endian base 10^9 limbs. Zero has no limbs and a positive value has a
// nonzero last limb; the field is private, so every value is canonical and
// `equal` is limb equality. There is no digit limit: values are bounded by
// memory only, and the kernel bounds its work with fuel charged per limb.
//
//     let n = match natural.parse(&Bytes.from("18446744073709551616")) { .. };
//     let m = natural.successor(&n);
//     io.write(io.stdout(), &natural.format(&m));
//
// Errors use the `std.text` codes: 22 (EINVAL) for malformed text, 34
// (ERANGE) for a negative `from_i64` argument.

use std.option.Option;
use std.result.Result;

pub struct Natural {
    limbs: Vec<i64>,
}

fn base() -> i64 ! {} { 1000000000 }

pub fn zero() -> Natural ! {alloc, panic} {
    let limbs: Vec<i64> = Vec.new();
    Natural { limbs: limbs }
}

/// The natural `value`; a negative `value` is `ERANGE`.
pub fn from_i64(value: i64) -> Result<Natural, i64> ! {alloc, panic} {
    if value < 0 { return Result.Err(34); }
    let mut limbs: Vec<i64> = Vec.with_capacity(3);
    let mut rest = value;
    while rest > 0 {
        limbs = Vec.push(limbs, rest % base());
        rest = rest / base();
    }
    Result.Ok(Natural { limbs: limbs })
}

/// An independent copy (a `Natural` owns its limbs).
pub fn copy(n: &Natural) -> Natural ! {alloc, panic} {
    let limbs = &n.limbs;
    let count = Vec.len(limbs);
    let mut out: Vec<i64> = Vec.with_capacity(count);
    let mut i = 0;
    while i < count {
        out = Vec.push(out, Vec.get(limbs, i));
        i = i + 1;
    }
    Natural { limbs: out }
}

pub fn is_zero(n: &Natural) -> Bool ! {} { Vec.len(&n.limbs) == 0 }

/// Number of base-10^9 limbs (0 for zero).
pub fn limb_count(n: &Natural) -> i64 ! {} { Vec.len(&n.limbs) }

/// Limb `i`, least significant first; `i` must be below `limb_count`.
pub fn limb(n: &Natural, i: i64) -> i64 ! {panic} { Vec.get(&n.limbs, i) }

/// The natural with these little-endian base-10^9 limbs. `EINVAL` unless the
/// limbs are canonical: each in 0..10^9 and the last one nonzero.
pub fn from_limbs(limbs: Vec<i64>) -> Result<Natural, i64> ! {panic} {
    let count = Vec.len(&limbs);
    let mut i = 0;
    let mut valid = true;
    while i < count {
        let limb = Vec.get(&limbs, i);
        if limb < 0 || limb >= base() { valid = false; }
        i = i + 1;
    }
    if count > 0 && Vec.get(&limbs, count - 1) == 0 { valid = false; }
    if !valid { return Result.Err(22); }
    Result.Ok(Natural { limbs: limbs })
}

/// Storage touched by an operation on `n`, at least 1: the kernel charges
/// numeric work in these units.
pub fn work(n: &Natural) -> i64 ! {} {
    let count = Vec.len(&n.limbs);
    if count == 0 { 1 } else { count }
}

/// Number of decimal digits (1 for zero).
pub fn digits(n: &Natural) -> i64 ! {panic} { limb_digits(&n.limbs) }

fn limb_digits(limbs: &Vec<i64>) -> i64 ! {panic} {
    let count = Vec.len(limbs);
    if count == 0 { return 1; }
    let mut last = Vec.get(limbs, count - 1);
    let mut width = 0;
    while last > 0 {
        last = last / 10;
        width = width + 1;
    }
    (count - 1) * 9 + width
}

/// `n + 1`.
pub fn successor(n: &Natural) -> Natural ! {alloc, panic} {
    let limbs = &n.limbs;
    let count = Vec.len(limbs);
    let mut out: Vec<i64> = Vec.with_capacity(count + 1);
    let mut carry = true;
    let mut i = 0;
    while i < count {
        let limb = Vec.get(limbs, i);
        if carry && limb == base() - 1 {
            out = Vec.push(out, 0);
        } else if carry {
            out = Vec.push(out, limb + 1);
            carry = false;
        } else {
            out = Vec.push(out, limb);
        }
        i = i + 1;
    }
    if carry { out = Vec.push(out, 1); }
    Natural { limbs: out }
}

/// `n - 1`, or `None` at zero: there is no saturating subtraction.
pub fn predecessor(n: &Natural) -> Option<Natural> ! {alloc, panic} {
    let limbs = &n.limbs;
    let count = Vec.len(limbs);
    if count == 0 { return Option.None; }
    let mut out: Vec<i64> = Vec.with_capacity(count);
    let mut borrow = true;
    let mut i = 0;
    while i < count {
        let limb = Vec.get(limbs, i);
        if borrow && limb == 0 {
            out = Vec.push(out, base() - 1);
        } else if borrow {
            out = Vec.push(out, limb - 1);
            borrow = false;
        } else {
            out = Vec.push(out, limb);
        }
        i = i + 1;
    }
    // Only the top limb can become zero (1 000000000 - 1 = 999999999).
    let length = if Vec.get(&out, count - 1) == 0 { count - 1 } else { count };
    if length == count { return Option.Some(Natural { limbs: out }); }
    let mut trimmed: Vec<i64> = Vec.with_capacity(length);
    let mut j = 0;
    while j < length {
        trimmed = Vec.push(trimmed, Vec.get(&out, j));
        j = j + 1;
    }
    Option.Some(Natural { limbs: trimmed })
}

/// -1, 0 or 1 as `a` is less than, equal to or greater than `b`.
pub fn compare(a: &Natural, b: &Natural) -> i64 ! {panic} {
    let left = &a.limbs;
    let right = &b.limbs;
    let count = Vec.len(left);
    if count != Vec.len(right) {
        return if count < Vec.len(right) { -1 } else { 1 };
    }
    let mut i = count - 1;
    while i >= 0 {
        let x = Vec.get(left, i);
        let y = Vec.get(right, i);
        if x != y {
            return if x < y { -1 } else { 1 };
        }
        i = i - 1;
    }
    0
}

pub fn equal(a: &Natural, b: &Natural) -> Bool ! {panic} { compare(a, b) == 0 }

/// The value as an `i64`, or `None` when it does not fit.
pub fn to_i64(n: &Natural) -> Option<i64> ! {panic} {
    let limbs = &n.limbs;
    let count = Vec.len(limbs);
    if count > 3 { return Option.None; }
    let limit = 9223372036854775807;
    let mut value = 0;
    let mut i = count - 1;
    while i >= 0 {
        if value > (limit - Vec.get(limbs, i)) / base() { return Option.None; }
        value = value * base() + Vec.get(limbs, i);
        i = i - 1;
    }
    Option.Some(value)
}

/// Parse one or more ASCII digits (leading zeros allowed, no sign or space).
pub fn parse(text: &Bytes) -> Result<Natural, i64> ! {alloc, panic} {
    let n = Bytes.len(text);
    if n == 0 { return Result.Err(22); }
    let mut at = 0;
    while at < n {
        let byte = Bytes.get(text, at);
        if byte < 48 || byte > 57 { return Result.Err(22); }
        at = at + 1;
    }
    let mut start = 0;
    while start < n && Bytes.get(text, start) == 48 {
        start = start + 1;
    }
    // Chunks of nine digits from the right; the leftmost may be shorter.
    let mut limbs: Vec<i64> = Vec.with_capacity((n - start) / 9 + 1);
    let mut end = n;
    while end > start {
        let first = if end - 9 > start { end - 9 } else { start };
        let mut limb = 0;
        let mut k = first;
        while k < end {
            limb = limb * 10 + (Bytes.get(text, k) - 48);
            k = k + 1;
        }
        limbs = Vec.push(limbs, limb);
        end = first;
    }
    Result.Ok(Natural { limbs: limbs })
}

/// Append the decimal digits of `n` (no leading zeros; `0` for zero).
pub fn format_into(out: Bytes, n: &Natural) -> Bytes ! {alloc, panic} {
    let limbs = &n.limbs;
    let count = Vec.len(limbs);
    if count == 0 { return Bytes.push(out, 48); }
    let mut out = out;
    let mut i = count - 1;
    let mut first = true;
    while i >= 0 {
        let limb = Vec.get(limbs, i);
        // The top limb is printed as is; the others are padded to 9 digits.
        let mut divisor = 100000000;
        if first {
            while divisor > 1 && limb / divisor == 0 {
                divisor = divisor / 10;
            }
        }
        while divisor > 0 {
            out = Bytes.push(out, 48 + (limb / divisor) % 10);
            divisor = divisor / 10;
        }
        first = false;
        i = i - 1;
    }
    out
}

pub fn format(n: &Natural) -> Bytes ! {alloc, panic} {
    format_into(Bytes.with_capacity(digits(n)), n)
}
