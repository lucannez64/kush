module std.web;

// Requests, and the linear Responder that answers each one exactly once
// (WEB-CORE, docs/web.md). A handler is `fn(&Request, Responder) -> Unit`:
// it receives the Responder by value and must pass it to exactly one of
// `text`, `json`, `status`, `reply` or `stream` (then `finish`) on every
// path, so a handler that forgets to answer on an error branch, or answers
// twice, does not compile. `html` comes with the `Html` type (WEB-HTML).
// `serve` (WEB-SERVER) runs one task per connection on the task reactor:
// it reads and parses each request with `std.http1`, keeps the connection
// alive, and stops gracefully when its task is cancelled. `serve_threads`
// (WEB-MULTICORE) runs one such server per OS thread.

use std.http1;
use std.http1.Field;
use std.http1.Body;
use std.http1.Framing;
use std.http1.Method;
use std.http1.Parse;
use std.net;
use std.option.Option;
use std.result.Result;
use std.sys;
use std.task.Panic;
use std.time;

/// A request: its method, target and header fields as received, and its
/// body. Header names and values are untrusted bytes.
pub struct Request {
    pub method: Method,
    /// The head as received; the target and `fields` are ranges of it.
    head: Bytes,
    target_from: i64,
    target_to: i64,
    fields: Vec<Field>,
    /// Whether the connection may carry another request afterwards.
    pub keep_alive: Bool,
    /// 0 for HTTP/1.0, 1 for HTTP/1.1.
    minor: i64,
    pub body: Bytes,
}

/// The request whose head `http1.parse_head` parsed at the start of
/// `buffer`, with its decoded `body`.
pub fn request(buffer: &Bytes, head: http1.Head, body: Bytes) -> Request ! {alloc, panic} {
    match head {
        http1.Head { method, target, target_end, minor, fields, framing, keep_alive, size } => {
            let mut copy = Bytes.with_capacity(size);
            let mut i = 0;
            while i < size && i < Bytes.len(buffer) {
                copy = Bytes.push(copy, Bytes.at(buffer, i, _));
                i = i + 1;
            }
            Request {
                method: method,
                head: copy,
                target_from: target,
                target_to: target_end,
                fields: fields,
                keep_alive: keep_alive,
                minor: minor,
                body: body,
            }
        },
    }
}

/// A request built directly, without parsing: no header fields. For tests
/// and in-process calls.
pub fn request_for(method: Method, target: &Bytes, body: Bytes) -> Request ! {alloc, panic} {
    let n = Bytes.len(target);
    let mut head = Bytes.with_capacity(n);
    let mut i = 0;
    while i < n {
        head = Bytes.push(head, Bytes.at(target, i, _));
        i = i + 1;
    }
    Request {
        method: method,
        head: head,
        target_from: 0,
        target_to: n,
        fields: Vec.new(),
        keep_alive: true,
        minor: 1,
        body: body,
    }
}

/// The byte at `i` of `b`, or -1 outside it.
fn byte(b: &Bytes, i: i64) -> i64 ! {} {
    if i >= 0 && i < Bytes.len(b) { Bytes.at(b, i, _) } else { -1 }
}

fn lower(c: i64) -> i64 ! {} {
    if c >= 65 && c <= 90 { c + 32 } else { c }
}

/// A copy of `b[start..end]`.
fn slice(b: &Bytes, start: i64, end: i64) -> Bytes ! {alloc, panic} {
    let length = if end > start { Int.wrapping_sub::<i64>(end, start) } else { 0 };
    let mut out = Bytes.with_capacity(length);
    let mut i = start;
    while i < end {
        let c = byte(b, i);
        if c < 0 { return out; }
        out = Bytes.push(out, c);
        i = Int.wrapping_add::<i64>(i, 1);
    }
    out
}

impl Request {
    /// The request target as sent: path and query.
    pub fn target(self: &Self) -> Bytes ! {alloc, panic} {
        slice(&self.head, self.target_from, self.target_to)
    }

    /// The end of the path: the '?' before the query, or the target's end.
    fn path_end(self: &Self) -> i64 ! {} {
        let mut i = self.target_from;
        while i < self.target_to {
            if byte(&self.head, i) == 63 { return i; }
            i = Int.wrapping_add::<i64>(i, 1);
        }
        self.target_to
    }

    /// The path, without the query (still percent-encoded; WEB-URL decodes).
    pub fn path(self: &Self) -> Bytes ! {alloc, panic} {
        slice(&self.head, self.target_from, self.path_end())
    }

    /// The query after '?', empty when there is none.
    pub fn query(self: &Self) -> Bytes ! {alloc, panic} {
        let end = self.path_end();
        if end == self.target_to { return Bytes.with_capacity(0); }
        slice(&self.head, Int.wrapping_add::<i64>(end, 1), self.target_to)
    }

    /// Whether the path is exactly `path`.
    pub fn path_is(self: &Self, path: &Bytes) -> Bool ! {} {
        let end = self.path_end();
        let n = Bytes.len(path);
        if Int.wrapping_sub::<i64>(end, self.target_from) != n { return false; }
        let mut i = 0;
        while i < n {
            if byte(&self.head, Int.wrapping_add::<i64>(self.target_from, i)) != Bytes.at(path, i, _) {
                return false;
            }
            i = i + 1;
        }
        true
    }

    /// The number of header fields.
    pub fn field_count(self: &Self) -> i64 ! {} {
        Vec.len(&self.fields)
    }

    /// The value of the first header field named `name` (ASCII
    /// case-insensitive), or None.
    pub fn header(self: &Self, name: &Bytes) -> Option<Bytes> ! {alloc, panic} {
        let count = Vec.len(&self.fields);
        let n = Bytes.len(name);
        let mut index = 0;
        while index < count {
            let field = Vec.get(&self.fields, index);
            if Int.wrapping_sub::<i64>(field.name_end, field.name) == n {
                let mut i = 0;
                let mut same = true;
                while i < n && same {
                    if lower(byte(&self.head, Int.wrapping_add::<i64>(field.name, i))) != lower(Bytes.at(name, i, _)) {
                        same = false;
                    }
                    i = i + 1;
                }
                if same {
                    return Option.Some(slice(&self.head, field.value, field.value_end));
                }
            }
            index = index + 1;
        }
        Option.None
    }
}

/// A response as a value, for handlers written as `fn(&Request) ->
/// Response`; see `answer`.
pub struct Response {
    pub status: i64,
    /// Sent as Content-Type unless empty; an invalid one is replaced by
    /// application/octet-stream.
    pub content_type: Bytes,
    pub body: Bytes,
}

/// Answers one request. Linear: a handler must pass it to exactly one of
/// `text`, `json`, `status`, `reply` or `stream` on every path. Only this
/// module makes one. When a panic unwinds past an unanswered one, it answers
/// `500 Internal Server Error` and the connection is closed
/// (PANIC-LINEAR-CLEANUP).
#[linear(unwind = abandon)]
pub struct Responder {
    fd: i64,
    /// A HEAD request: the head is sent, the body is not.
    head_only: Bool,
    keep_alive: Bool,
    /// HTTP/1.1: a stream may use chunked transfer coding. An HTTP/1.0
    /// client gets the body as is, ended by closing the connection.
    chunked: Bool,
    timeout_ms: i64,
}

/// A response being streamed in chunks. Linear: it must reach `finish`.
/// When a panic unwinds past one, nothing more is sent: the connection is
/// closed, so the client sees the body cut off, not a complete one.
#[linear(unwind = abandon_stream)]
pub struct Stream {
    fd: i64,
    head_only: Bool,
    /// Data goes out as is (HTTP/1.0), not in chunks.
    raw: Bool,
    /// A write failed; the rest is skipped and the server drops the
    /// connection.
    failed: Bool,
    timeout_ms: i64,
}

fn abandon(res: Responder) -> Unit ! {io, alloc, panic, suspend} {
    match res {
        Responder { fd, head_only, keep_alive, chunked, timeout_ms } => {
            let none = Bytes.with_capacity(0);
            let bytes = head(500, &none, 0, false);
            let _ = send(fd, &bytes, timeout_ms);
        },
    }
}

fn abandon_stream(stream: Stream) -> Unit ! {} {
    match stream {
        Stream { fd, head_only, raw, failed, timeout_ms } => (),
    }
}

/// The Responder for `request` on `conn` (for the server and `capture`).
fn responder(conn: &net.Conn, request: &Request, timeout_ms: i64) -> Responder ! {} {
    let head_only = match request.method { Method.Head => true, _ => false };
    Responder {
        fd: net.descriptor(conn),
        head_only: head_only,
        keep_alive: request.keep_alive,
        chunked: request.minor == 1,
        timeout_ms: timeout_ms,
    }
}

/// Send all of `data` on the reactor within `timeout_ms`: whether it was.
fn send(fd: i64, data: &Bytes, timeout_ms: i64) -> Bool ! {io, suspend} {
    let deadline = time.deadline_ms(timeout_ms);
    let length = Bytes.len(data);
    let mut sent = 0;
    while sent < length {
        match sys.send(fd, data, sent) {
            Result.Ok(count) => {
                if count == 0 { return false; }
                sent = Int.wrapping_add::<i64>(sent, count);
            },
            Result.Err(code) => {
                if code == sys.EAGAIN() {
                    // Shielded: a response is finished even while the
                    // server stops (within its timeout).
                    match sys.wait_ready(fd, sys.POLLOUT() | sys.WAIT_SHIELD(), time.remaining_ms(deadline)) {
                        Result.Ok(0) => {
                            if time.remaining_ms(deadline) == 0 { return false; }
                        },
                        Result.Ok(_) => {},
                        Result.Err(code) => {
                            if code != sys.EINTR() { return false; }
                        },
                    }
                } else if code != sys.EINTR() {
                    return false;
                }
            },
        }
    }
    true
}

fn append(out: Bytes, text: &Bytes) -> Bytes ! {alloc, panic} {
    let mut out = out;
    let n = Bytes.len(text);
    let mut i = 0;
    while i < n {
        out = Bytes.push(out, Bytes.at(text, i, _));
        i = i + 1;
    }
    out
}

/// Whether `value` may be a header value: no CR, LF, NUL or other control
/// character but tab.
fn valid_value(value: &Bytes) -> Bool ! {} {
    let n = Bytes.len(value);
    let mut i = 0;
    while i < n {
        let c = Bytes.at(value, i, _);
        if !(c == 9 || (c >= 32 && c != 127)) { return false; }
        i = i + 1;
    }
    true
}

/// Whether a response with `status` carries no body (1xx, 204, 304).
fn bodiless(status: i64) -> Bool ! {} {
    status < 200 || status == 204 || status == 304
}

/// The response head: status line, Content-Type unless `content_type` is
/// empty, Content-Length (chunked when `length` is -1, neither when -2:
/// the body ends with the connection), and Connection: close when the
/// connection ends after it.
fn head(status: i64, content_type: &Bytes, length: i64, keep_alive: Bool) -> Bytes ! {alloc, panic} {
    let mut out = http1.status_line(Bytes.with_capacity(128), status);
    if Bytes.len(content_type) > 0 {
        let name = Bytes.from("Content-Type: ");
        out = append(out, &name);
        if valid_value(content_type) {
            out = append(out, content_type);
        } else {
            // A value with CR or LF could inject header fields.
            let fallback = Bytes.from("application/octet-stream");
            out = append(out, &fallback);
        }
        out = Bytes.push(Bytes.push(out, 13), 10);
    }
    if !bodiless(status) {
        if length >= 0 {
            out = http1.content_length(out, length);
        } else if length == -1 {
            let chunked = Bytes.from("Transfer-Encoding: chunked\r\n");
            out = append(out, &chunked);
        }
    }
    if !keep_alive {
        let close = Bytes.from("Connection: close\r\n");
        out = append(out, &close);
    }
    http1.end_head(out)
}

impl Responder {
    /// Answer with `body` as text/plain; charset=utf-8.
    pub fn text(self: Self, status: i64, body: &Bytes) -> Unit ! {io, alloc, panic, suspend} {
        let kind = Bytes.from("text/plain; charset=utf-8");
        self.complete(status, &kind, body)
    }

    /// Answer with `body` as application/json.
    pub fn json(self: Self, status: i64, body: &Bytes) -> Unit ! {io, alloc, panic, suspend} {
        let kind = Bytes.from("application/json");
        self.complete(status, &kind, body)
    }

    /// Answer with an empty body.
    pub fn status(self: Self, status: i64) -> Unit ! {io, alloc, panic, suspend} {
        let none = Bytes.with_capacity(0);
        self.complete(status, &none, &none)
    }

    /// Answer with a `Response` value.
    pub fn reply(self: Self, response: Response) -> Unit ! {io, alloc, panic, suspend} {
        match response {
            Response { status, content_type, body } => self.complete(status, &content_type, &body),
        }
    }

    /// Start a chunked response; send the body with `Stream.send` and end
    /// it with `Stream.finish`. For HEAD only the head is sent.
    pub fn stream(self: Self, status: i64, content_type: &Bytes) -> Stream ! {io, alloc, panic, suspend} {
        match self {
            Responder { fd, head_only, keep_alive, chunked, timeout_ms } => {
                let length = if chunked { -1 } else { -2 };
                let bytes = head(status, content_type, length, keep_alive && chunked);
                let sent = send(fd, &bytes, timeout_ms);
                Stream {
                    fd: fd,
                    head_only: head_only || bodiless(status),
                    raw: !chunked,
                    failed: !sent,
                    timeout_ms: timeout_ms,
                }
            },
        }
    }

    fn complete(self: Self, status: i64, content_type: &Bytes, body: &Bytes) -> Unit ! {io, alloc, panic, suspend} {
        match self {
            Responder { fd, head_only, keep_alive, chunked, timeout_ms } => {
                let mut bytes = head(status, content_type, Bytes.len(body), keep_alive);
                if !head_only && !bodiless(status) { bytes = append(bytes, body); }
                let _ = send(fd, &bytes, timeout_ms);
            },
        }
    }
}

impl Stream {
    /// Send `data` as one chunk (empty data sends nothing).
    pub fn send(self: Self, data: &Bytes) -> Stream ! {io, alloc, panic, suspend} {
        match self {
            Stream { fd, head_only, raw, failed, timeout_ms } => {
                let mut failed = failed;
                if !failed && !head_only && Bytes.len(data) > 0 {
                    if raw {
                        failed = !send(fd, data, timeout_ms);
                    } else {
                        let bytes = http1.chunk(Bytes.with_capacity(Int.saturating_add::<i64>(Bytes.len(data), 32)), data);
                        failed = !send(fd, &bytes, timeout_ms);
                    }
                }
                Stream { fd: fd, head_only: head_only, raw: raw, failed: failed, timeout_ms: timeout_ms }
            },
        }
    }

    /// End the body.
    pub fn finish(self: Self) -> Unit ! {io, alloc, panic, suspend} {
        match self {
            Stream { fd, head_only, raw, failed, timeout_ms } => {
                if !failed && !head_only && !raw {
                    let bytes = http1.last_chunk(Bytes.with_capacity(8));
                    let _ = send(fd, &bytes, timeout_ms);
                }
            },
        }
    }
}

/// Answer `request` with what `handler` returns: the `fn(&Request) ->
/// Response` form of a handler.
pub fn answer(request: &Request, res: Responder, handler: fn(&Request) -> Response ! {io, alloc, panic, suspend}) -> Unit ! {io, alloc, panic, suspend} {
    res.reply(handler(request))
}

/// Run `handler` on `request` over a loopback connection and return the
/// raw response (status line, head and body), for tests. Everything runs in
/// the calling task, so the response must fit in the loopback socket
/// buffers (megabytes). WEB-TEST-CLIENT builds on this.
pub fn capture(request: &Request, handler: fn(&Request, Responder) -> Unit ! {io, alloc, panic, suspend}) -> Result<Bytes, i64> ! {io, alloc, panic, suspend} {
    let host = Bytes.from("127.0.0.1");
    let listener = match net.listen(&host, 0, 1, false) {
        Result.Ok(listener) => listener,
        Result.Err(code) => { return Result.Err(code); },
    };
    let port = match net.local_port(&listener) {
        Result.Ok(port) => port,
        Result.Err(code) => {
            let _ = net.close_listener(listener);
            return Result.Err(code);
        },
    };
    let client = match net.connect(&host, port, 5000) {
        Result.Ok(conn) => conn,
        Result.Err(code) => {
            let _ = net.close_listener(listener);
            return Result.Err(code);
        },
    };
    let accepted = net.accept(&listener, 5000);
    let _ = net.close_listener(listener);
    let server = match accepted {
        Result.Ok(conn) => conn,
        Result.Err(code) => {
            let _ = net.close(client);
            return Result.Err(code);
        },
    };
    handler(request, responder(&server, request, 5000));
    let _ = net.close(server);
    let mut out = Bytes.with_capacity(65536);
    loop {
        let before = Bytes.len(&out);
        if before == Bytes.capacity(&out) {
            let mut bigger = Bytes.with_capacity(Int.saturating_mul::<i64>(before, 2));
            bigger = append(bigger, &out);
            drop(out);
            out = bigger;
        }
        out = match net.read(&client, out, 5000) {
            Result.Ok(next) => next,
            Result.Err(code) => {
                let _ = net.close(client);
                return Result.Err(code);
            },
        };
        if Bytes.len(&out) == before {
            let _ = net.close(client);
            return Result.Ok(out);
        }
    }
}

// ---- The server (WEB-SERVER) ----------------------------------------------

/// Server settings.
pub struct Config {
    pub limits: http1.Limits,
    /// How long a kept-alive connection may wait for its next request.
    pub idle_ms: i64,
    /// How long the rest of a started request may take to arrive, and how
    /// long each response may take to send.
    pub request_ms: i64,
    /// The backlog of the listeners `serve_threads` opens for its threads.
    pub backlog: i64,
}

/// `http1.limits()`, 5 s idle, 30 s per request and response, a backlog of
/// 1024.
pub fn config() -> Config ! {} {
    Config { limits: http1.limits(), idle_ms: 5000, request_ms: 30000, backlog: 1024 }
}

/// What reading a request produced.
enum Got {
    /// The buffer holding the head, and the parsed head.
    Head(Bytes, http1.Head),
    /// The buffer, the decoded body, and the bytes the request used.
    Body(Bytes, Bytes, i64),
    /// Close the connection without an answer (peer gone, idle timeout,
    /// stopping).
    Close,
    /// Answer with this status, then close.
    Refuse(i64),
}

fn min(a: i64, b: i64) -> i64 ! {} { if a < b { a } else { b } }

/// Read more into `buffer`, growing it up to `cap` bytes, within
/// `timeout_ms`. A shielded read is not interrupted by cancellation. The
/// buffer comes back longer, or unchanged when the peer closed; on failure
/// (ETIMEDOUT 110, ECANCELED 125, EFBIG 27 at `cap`, ...) it is freed.
fn receive(fd: i64, buffer: Bytes, cap: i64, timeout_ms: i64, shield: Bool) -> Result<Bytes, i64> ! {io, alloc, panic, suspend} {
    let mut buffer = buffer;
    let length = Bytes.len(&buffer);
    if length >= Bytes.capacity(&buffer) {
        if length >= cap { return Result.Err(27); }
        let wanted = min(Int.saturating_add::<i64>(Int.saturating_mul::<i64>(length, 2), 4096), cap);
        let mut bigger = Bytes.with_capacity(wanted);
        bigger = append(bigger, &buffer);
        drop(buffer);
        buffer = bigger;
    }
    let spare = Int.wrapping_sub::<i64>(Bytes.capacity(&buffer), Bytes.len(&buffer));
    let deadline = time.deadline_ms(timeout_ms);
    let events = if shield { sys.POLLIN() | sys.WAIT_SHIELD() } else { sys.POLLIN() };
    loop {
        match sys.wait_ready(fd, events, time.remaining_ms(deadline)) {
            Result.Ok(0) => {
                if time.remaining_ms(deadline) == 0 { return Result.Err(110); }
            },
            Result.Ok(_) => { return sys.read(fd, buffer, spare, -1); },
            Result.Err(code) => {
                if code != sys.EINTR() { return Result.Err(code); }
            },
        }
    }
}

/// Read until a whole request head is in `buffer`. Waiting for the first
/// byte uses the idle deadline and can be cancelled; the rest of a started
/// head is shielded and uses the request deadline.
fn read_head(fd: i64, buffer: Bytes, config: &Config) -> Got ! {io, alloc, panic, suspend} {
    let mut buffer = buffer;
    let cap = Int.saturating_add::<i64>(config.limits.head, 1);
    loop {
        match http1.parse_head(&buffer, &config.limits) {
            Parse.Complete(head) => { return Got.Head(buffer, head); },
            Parse.Reject(status) => { return Got.Refuse(status); },
            Parse.Incomplete => {},
        }
        let before = Bytes.len(&buffer);
        let idle = before == 0;
        let timeout = if idle { config.idle_ms } else { config.request_ms };
        match receive(fd, buffer, cap, timeout, !idle) {
            Result.Ok(next) => {
                buffer = next;
                if Bytes.len(&buffer) == before { return Got.Close; }
            },
            Result.Err(code) => {
                return if code == 110 && !idle { Got.Refuse(408) }
                    else if code == 27 { Got.Refuse(431) }
                    else { Got.Close };
            },
        }
    }
}

/// Read the body `head` declares (shielded, within the request deadline):
/// the buffer, the decoded body, and the bytes the request used.
fn read_body(fd: i64, buffer: Bytes, head: &http1.Head, config: &Config) -> Got ! {io, alloc, panic, suspend} {
    let mut buffer = buffer;
    let start = head.size;
    match head.framing {
        Framing.Empty => Got.Body(buffer, Bytes.with_capacity(0), start),
        Framing.Length(length) => {
            let end = Int.saturating_add::<i64>(start, length);
            while Bytes.len(&buffer) < end {
                let before = Bytes.len(&buffer);
                match receive(fd, buffer, end, config.request_ms, true) {
                    Result.Ok(next) => {
                        buffer = next;
                        if Bytes.len(&buffer) == before { return Got.Close; }
                    },
                    Result.Err(code) => {
                        return if code == 110 { Got.Refuse(408) } else { Got.Close };
                    },
                }
            }
            let body = slice(&buffer, start, end);
            Got.Body(buffer, body, end)
        },
        Framing.Chunked => {
            // Chunk framing adds a little to the body; allow for it.
            let cap = Int.saturating_add::<i64>(
                Int.saturating_add::<i64>(start, Int.saturating_mul::<i64>(config.limits.body, 2)),
                config.limits.head,
            );
            loop {
                match http1.chunked_size(&buffer, start, &config.limits) {
                    Body.Complete(length, next) => {
                        let body = http1.chunked_copy(&buffer, start, Bytes.with_capacity(length));
                        return Got.Body(buffer, body, next);
                    },
                    Body.Reject(status) => { return Got.Refuse(status); },
                    Body.Incomplete => {},
                }
                let before = Bytes.len(&buffer);
                match receive(fd, buffer, cap, config.request_ms, true) {
                    Result.Ok(next) => {
                        buffer = next;
                        if Bytes.len(&buffer) == before { return Got.Close; }
                    },
                    Result.Err(code) => {
                        return if code == 110 { Got.Refuse(408) }
                            else if code == 27 { Got.Refuse(413) }
                            else { Got.Close };
                    },
                }
            }
        },
    }
}

/// `buffer` without its first `from` bytes: what a pipelining client sent
/// after the request just answered.
fn rest(buffer: Bytes, from: i64) -> Bytes ! {alloc, panic} {
    let mut out = Bytes.with_capacity(Bytes.capacity(&buffer));
    let n = Bytes.len(&buffer);
    let mut i = if from > 0 { from } else { 0 };
    while i < n {
        out = Bytes.push(out, byte(&buffer, i));
        i = Int.wrapping_add::<i64>(i, 1);
    }
    out
}

/// Answer `status` with an empty body and Connection: close.
fn refuse(fd: i64, status: i64, timeout_ms: i64) -> Unit ! {io, alloc, panic, suspend} {
    let none = Bytes.with_capacity(0);
    let bytes = head(status, &none, 0, false);
    let _ = send(fd, &bytes, timeout_ms);
}

/// Serve the requests of one connection until it closes, it is not kept
/// alive, or the server stops.
fn connection(conn: net.Conn, handler: fn(&Request, Responder) -> Unit ! {io, alloc, panic, suspend}, config: Config) -> Unit ! {io, alloc, panic, suspend} {
    let fd = net.descriptor(&conn);
    let mut buffer = Bytes.with_capacity(4096);
    loop {
        let (bytes, head) = match read_head(fd, buffer, &config) {
            Got.Head(bytes, head) => (bytes, head),
            Got.Refuse(status) => {
                refuse(fd, status, config.request_ms);
                let _ = net.close(conn);
                return ();
            },
            _ => {
                let _ = net.close(conn);
                return ();
            },
        };
        let (bytes, body, used) = match read_body(fd, bytes, &head, &config) {
            Got.Body(bytes, body, used) => (bytes, body, used),
            Got.Refuse(status) => {
                refuse(fd, status, config.request_ms);
                let _ = net.close(conn);
                return ();
            },
            _ => {
                let _ = net.close(conn);
                return ();
            },
        };
        let req = request(&bytes, head, body);
        let keep = req.keep_alive;
        let res = responder(&conn, &req, config.request_ms);
        // A panic in the handler is caught here (PANIC-UNWIND-USE): the
        // handler's frames were unwound, and an unanswered Responder answered
        // 500 on the way (its unwind cleanup). The connection then closes,
        // since a response may be cut off.
        let ran = Task.catch(fn() -> Unit ! {io, alloc, panic, suspend} {
            handler(&req, res)
        });
        buffer = rest(bytes, used);
        let panicked = match ran {
            Result.Ok(_) => false,
            Result.Err(_) => true,
        };
        if panicked || !keep || Task.check_cancel() {
            let _ = net.close(conn);
            return ();
        }
    }
}

/// Whether an accept error is worth retrying (out of descriptors or
/// memory, a protocol error on one connection).
fn transient(code: i64) -> Bool ! {} {
    code == 23 || code == 24 || code == 12 || code == 105 || code == 71
}

/// Serve `listener` until the calling task is cancelled: one task per
/// connection, running `handler` for each request on it, with keep-alive
/// and pipelining. Malformed or oversized requests are answered with their
/// 4xx status by the server, without calling the handler. On cancellation
/// the server stops gracefully: it accepts no more connections, closes
/// idle ones, and lets requests being handled finish: reading the rest of a
/// request and writing a response use shielded waits within `request_ms`,
/// while a handler's own waits see the cancellation. A handler that panics ends only its
/// own task: the client gets a 500 if nothing was sent yet, and the
/// connection is closed; what the handler owned is leaked.
/// Returns Ok(()) after such a stop, or the accept error that ended it.
pub fn serve(listener: net.Listener, handler: fn(&Request, Responder) -> Unit ! {io, alloc, panic, suspend}, config: Config) -> Result<Unit, i64> ! {io, alloc, panic, suspend} {
    let ended = Task.scope(fn() -> Result<Unit, i64> ! {io, alloc, panic, suspend} {
        loop {
            match net.accept(&listener, 0) {
                Result.Ok(conn) => {
                    Task.spawn(fn() -> Unit ! {io, alloc, panic, suspend} { connection(conn, handler, config) });
                },
                Result.Err(code) => {
                    if code == sys.ECANCELED() || !transient(code) {
                        let _ = net.close_listener(listener);
                        // An Err result makes the scope cancel the
                        // connection tasks before joining them.
                        return Result.Err(code);
                    }
                    let _ = time.wait_ms(10);
                },
            }
        }
    });
    match ended {
        Result.Err(code) => if code == sys.ECANCELED() { Result.Ok(()) } else { Result.Err(code) },
        Result.Ok(_) => Result.Ok(()),
    }
}

// ---- One server per thread (WEB-MULTICORE) --------------------------------

/// Stop every thread of `serve_threads`: they wait on the read end of a pipe
/// that nobody reads, so after one byte it stays readable for all of them.
fn raise_stop(signal: i64) -> Unit ! {io, alloc, panic} {
    let _ = sys.write(signal, &Bytes.from("!"), 0, -1);
}

/// Keep the first error any thread met.
fn first_error(errors: &[Atomic], code: i64) -> Unit ! {panic} {
    let _ = Atomic.compare_exchange(errors, 0, 0, code);
}

/// One thread's server: `serve` in a task until the stop signal, or until
/// the calling task is cancelled; either way, and when its own `serve`
/// ends, every thread stops. A panic outside the handlers (they have their
/// own catch) stops the other threads too before it goes on, so no thread
/// waits forever at the scope's end.
fn serve_part(listener: net.Listener, handler: fn(&Request, Responder) -> Unit ! {io, alloc, panic, suspend}, config: Config, stop: i64, signal: i64, errors: &[Atomic]) -> Unit ! {io, alloc, panic, suspend} {
    let ran = Task.catch(fn() -> Unit ! {io, alloc, panic, suspend} {
        let server = Task.spawn(fn() -> Unit ! {io, alloc, panic, suspend} {
            match serve(listener, handler, config) {
                Result.Err(code) => first_error(errors, code),
                Result.Ok(_) => {},
            }
            raise_stop(signal);
        });
        loop {
            match sys.wait_ready(stop, sys.POLLIN(), -1) {
                Result.Ok(_) => { break; },
                // ECANCELED: the calling task was cancelled.
                Result.Err(code) => { if code != sys.EINTR() { break; } },
            }
        }
        raise_stop(signal);
        Task.cancel(&server);
        let _ = Task.join(server);
    });
    match ran {
        Result.Ok(_) => {},
        Result.Err(_) => { raise_stop(signal); panic() },
    }
}

/// Serve on `threads` OS threads, each with its own scheduler, reactor and
/// listener: `listener` (opened with `reuse_port`) serves on the calling
/// thread, and `threads - 1` more listeners on `host` and the same port
/// serve on new threads; the kernel spreads connections over them
/// (SO_REUSEPORT), and a connection stays on the thread that accepted it.
/// `handler` and `config` are as for `serve`. Cancelling the calling task
/// stops every thread gracefully, as `serve` stops; so does an accept error
/// on any thread, which is then returned. EINVAL unless 1 <= threads <= 1024.
pub fn serve_threads(listener: net.Listener, host: &Bytes, threads: i64, handler: fn(&Request, Responder) -> Unit ! {io, alloc, panic, suspend}, config: Config) -> Result<Unit, i64> ! {io, alloc, panic, suspend} {
    if threads < 1 || threads > 1024 {
        let _ = net.close_listener(listener);
        return Result.Err(22);
    }
    let port = match net.local_port(&listener) {
        Result.Ok(port) => port,
        Result.Err(code) => {
            let _ = net.close_listener(listener);
            return Result.Err(code);
        },
    };
    let ends = match sys.pipe() {
        Result.Ok(ends) => ends,
        Result.Err(code) => {
            let _ = net.close_listener(listener);
            return Result.Err(code);
        },
    };
    let stop = ends & 4294967295;
    let signal = ends >> 32;
    let mut cells: Vec<Atomic> = Vec.with_capacity(1);
    cells = Vec.push(cells, Atomic.new(0));
    let errors: &[Atomic] = &cells[..];
    Thread.scope(fn() -> Unit ! {io, alloc, panic, suspend} {
        let mut i = 1;
        while i < threads {
            match net.listen(host, port, config.backlog, true) {
                Result.Ok(extra) => {
                    Thread.spawn(fn() -> Unit ! {io, alloc, panic, suspend} {
                        serve_part(extra, handler, config, stop, signal, errors)
                    });
                },
                Result.Err(code) => {
                    first_error(errors, code);
                    raise_stop(signal);
                    break;
                },
            }
            i = i + 1;
        }
        serve_part(listener, handler, config, stop, signal, errors);
    });
    let _ = sys.close(stop);
    let _ = sys.close(signal);
    let code = Atomic.load(errors, 0);
    if code == 0 { Result.Ok(()) } else { Result.Err(code) }
}
