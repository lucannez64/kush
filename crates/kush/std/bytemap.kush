module std.bytemap;

// A hash map from byte-string keys to copyable values (STD-BYTEMAP).
//
// Open addressing with linear probing over a power-of-two table, FNV-1a
// hashing, and tombstones for removal. Keys are copied into one key arena;
// removed keys leave garbage there until the table is rebuilt, which happens
// when it grows or when tombstones and garbage dominate.
//
// Ownership style: operations that change the map consume it and return it.
//
//     let mut m: bytemap.Map<i64> = bytemap.new();
//     m = bytemap.insert(m, &Bytes.from("k"), 7);
//     match bytemap.get(&m, &Bytes.from("k")) { Option.Some(v) => .., Option.None => .. }
//
// Iterate with `next_slot` / `key_into` / `value_at`.

use std.option.Option;

/// Slot states.
fn empty_slot() -> i64 ! {} { 0 }
fn full_slot() -> i64 ! {} { 1 }
fn removed_slot() -> i64 ! {} { 2 }

pub struct Map<V> {
    /// Per slot: 0 empty, 1 full, 2 removed.
    states: Vec<i64>,
    hashes: Vec<u64>,
    key_start: Vec<i64>,
    key_len: Vec<i64>,
    values: Vec<V>,
    arena: Bytes,
    /// Live entries.
    count: i64,
    /// Removed slots (they still end probe chains only when empty).
    removed: i64,
    /// Bytes of the arena that belong to removed keys.
    garbage: i64,
}

/// FNV-1a over all of `key`.
pub fn hash(key: &Bytes) -> u64 ! {panic} {
    let mut h: u64 = 14695981039346656037;
    let n = Bytes.len(key);
    let mut i = 0;
    while i < n {
        let byte: u64 = Int.truncate(Bytes.at(key, i, _));
        h = Int.wrapping_mul(h ^ byte, 1099511628211);
        i = i + 1;
    }
    h
}

fn table<V>(slots: i64, filler: V, arena_capacity: i64) -> Map<V> ! {alloc, panic} {
    let mut states: Vec<i64> = Vec.with_capacity(slots);
    let mut hashes: Vec<u64> = Vec.with_capacity(slots);
    let mut key_start: Vec<i64> = Vec.with_capacity(slots);
    let mut key_len: Vec<i64> = Vec.with_capacity(slots);
    let mut values: Vec<V> = Vec.with_capacity(slots);
    let mut i = 0;
    while i < slots {
        states = Vec.push(states, 0);
        hashes = Vec.push(hashes, 0);
        key_start = Vec.push(key_start, 0);
        key_len = Vec.push(key_len, 0);
        values = Vec.push(values, filler);
        i = i + 1;
    }
    Map {
        states: states,
        hashes: hashes,
        key_start: key_start,
        key_len: key_len,
        values: values,
        arena: Bytes.with_capacity(arena_capacity),
        count: 0,
        removed: 0,
        garbage: 0,
    }
}

/// An empty map. `filler` is stored in unused slots and never returned.
pub fn new<V>(filler: V) -> Map<V> ! {alloc, panic} {
    table(16, filler, 256)
}

/// Number of live entries.
pub fn len<V>(map: &Map<V>) -> i64 ! {} {
    map.count
}

/// Number of slots, for iteration with `next_slot`.
pub fn slots<V>(map: &Map<V>) -> i64 ! {} {
    Vec.len(&map.states)
}

fn key_equals<V>(map: &Map<V>, slot: i64, key: &Bytes) -> Bool ! {panic} {
    let n = Vec.get(&map.key_len, slot);
    if n != Bytes.len(key) {
        return false;
    }
    let start = Vec.get(&map.key_start, slot);
    let mut i = 0;
    while i < n {
        if Bytes.get(&map.arena, start + i) != Bytes.at(key, i, _) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn slot_of(h: u64, slots: i64) -> i64 ! {panic} {
    let mask: u64 = Int.truncate(slots - 1);
    Int.truncate(h & mask)
}

/// The slot holding `key`, or -1.
fn find<V>(map: &Map<V>, key: &Bytes, h: u64) -> i64 ! {panic} {
    let slots = Vec.len(&map.states);
    let mut slot = slot_of(h, slots);
    let mut probes = 0;
    while probes < slots {
        let state = Vec.get(&map.states, slot);
        if state == 0 {
            return -1;
        }
        if state == 1 && Vec.get(&map.hashes, slot) == h && key_equals(map, slot, key) {
            return slot;
        }
        slot = (slot + 1) % slots;
        probes = probes + 1;
    };
    -1
}

pub fn get<V>(map: &Map<V>, key: &Bytes) -> Option<V> ! {panic} {
    let slot = find(map, key, hash(key));
    if slot < 0 { Option.None } else { Option.Some(Vec.get(&map.values, slot)) }
}

pub fn contains<V>(map: &Map<V>, key: &Bytes) -> Bool ! {panic} {
    find(map, key, hash(key)) >= 0
}

/// The first free (empty or removed) slot on `h`'s probe chain. The table
/// always has an empty slot, so this terminates.
fn free_slot<V>(map: &Map<V>, h: u64) -> i64 ! {panic} {
    let slots = Vec.len(&map.states);
    let mut slot = slot_of(h, slots);
    while Vec.get(&map.states, slot) == 1 {
        slot = (slot + 1) % slots;
    }
    slot
}

/// Store a new key that is known to be absent.
fn place<V>(map: Map<V>, key: &Bytes, start: i64, n: i64, h: u64, value: V) -> Map<V> ! {alloc, panic} {
    let slot = free_slot(&map, h);
    match map {
        Map { states, hashes, key_start, key_len, values, arena, count, removed, garbage } => {
            let was_removed = Vec.get(&states, slot) == 2;
            let mut arena = arena;
            let offset = Bytes.len(&arena);
            let mut i = start;
            while i < start + n {
                arena = Bytes.push(arena, Bytes.get(key, i));
                i = i + 1;
            }
            Map {
                states: Vec.set(states, slot, 1),
                hashes: Vec.set(hashes, slot, h),
                key_start: Vec.set(key_start, slot, offset),
                key_len: Vec.set(key_len, slot, n),
                values: Vec.set(values, slot, value),
                arena: arena,
                count: count + 1,
                removed: if was_removed { removed - 1 } else { removed },
                garbage: garbage,
            }
        },
    }
}

/// Rebuild into `slots` slots, dropping tombstones and arena garbage.
fn rebuild<V>(map: Map<V>, slots: i64, filler: V) -> Map<V> ! {alloc, panic} {
    let mut fresh = table(slots, filler, Bytes.len(&map.arena) - map.garbage + 16);
    let old_slots = Vec.len(&map.states);
    let mut slot = 0;
    while slot < old_slots {
        if Vec.get(&map.states, slot) == 1 {
            fresh = place(
                fresh,
                &map.arena,
                Vec.get(&map.key_start, slot),
                Vec.get(&map.key_len, slot),
                Vec.get(&map.hashes, slot),
                Vec.get(&map.values, slot),
            );
        }
        slot = slot + 1;
    }
    drop(map);
    fresh
}

/// Insert or replace the value for `key`.
pub fn insert<V>(map: Map<V>, key: &Bytes, value: V) -> Map<V> ! {alloc, panic} {
    let h = hash(key);
    let existing = find(&map, key, h);
    if existing >= 0 {
        return match map {
            Map { states, hashes, key_start, key_len, values, arena, count, removed, garbage } => Map {
                states: states,
                hashes: hashes,
                key_start: key_start,
                key_len: key_len,
                values: Vec.set(values, existing, value),
                arena: arena,
                count: count,
                removed: removed,
                garbage: garbage,
            },
        };
    }
    // Keep the load (live + removed) at most 3/4 after this insert.
    let slots = Vec.len(&map.states);
    let mut map = map;
    if (map.count + map.removed + 1) * 4 > slots * 3 {
        let grown = if (map.count + 1) * 2 > slots { slots * 2 } else { slots };
        map = rebuild(map, grown, value);
    }
    place(map, key, 0, Bytes.len(key), h, value)
}

/// Remove `key` if present.
pub fn remove<V>(map: Map<V>, key: &Bytes) -> Map<V> ! {alloc, panic} {
    let slot = find(&map, key, hash(key));
    if slot < 0 {
        return map;
    }
    let map = match map {
        Map { states, hashes, key_start, key_len, values, arena, count, removed, garbage } => {
            let n = Vec.get(&key_len, slot);
            Map {
                states: Vec.set(states, slot, 2),
                hashes: hashes,
                key_start: key_start,
                key_len: key_len,
                values: values,
                arena: arena,
                count: count - 1,
                removed: removed + 1,
                garbage: garbage + n,
            }
        },
    };
    // Reclaim the arena when most of it is garbage.
    if map.garbage > 4096 && map.garbage * 2 > Bytes.len(&map.arena) {
        let slots = Vec.len(&map.states);
        let filler = Vec.get(&map.values, slot);
        return rebuild(map, slots, filler);
    }
    map
}

/// The first full slot at or after `from`, or -1 when there is none.
pub fn next_slot<V>(map: &Map<V>, from: i64) -> i64 ! {panic} {
    let slots = Vec.len(&map.states);
    let mut slot = if from < 0 { 0 } else { from };
    while slot < slots {
        if Vec.get(&map.states, slot) == 1 {
            return slot;
        }
        slot = slot + 1;
    };
    -1
}

/// Append the key stored in full slot `slot` to `out`.
pub fn key_into<V>(map: &Map<V>, slot: i64, out: Bytes) -> Bytes ! {alloc, panic} {
    let start = Vec.get(&map.key_start, slot);
    let n = Vec.get(&map.key_len, slot);
    let mut out = out;
    let mut i = 0;
    while i < n {
        out = Bytes.push(out, Bytes.get(&map.arena, start + i));
        i = i + 1;
    }
    out
}

/// The value stored in full slot `slot`.
pub fn value_at<V>(map: &Map<V>, slot: i64) -> V ! {panic} {
    Vec.get(&map.values, slot)
}
