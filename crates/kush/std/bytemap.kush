module std.bytemap;

// A hash map from byte-string keys to copyable values (STD-BYTEMAP).
//
// Open addressing with linear probing over a power-of-two table, FNV-1a
// hashing, and tombstones for removal. Keys are copied into one key arena;
// removed keys leave garbage there until the table is rebuilt, which happens
// when it grows or when tombstones and garbage dominate.
//
// Ownership style: operations that change the map consume it and return it.
//
//     let mut m: bytemap.Map<i64> = bytemap.new(0);
//     m = bytemap.insert(m, &Bytes.from("k"), 7);
//     match bytemap.get(&m, &Bytes.from("k")) { Option.Some(v) => .., Option.None => .. }
//
// Iterate with `next_slot` / `key_into` / `value_at`.
//
// Probes read slots with `Vec.at`: each read is proved in bounds by the
// probe loop's range check, so it is a plain load.

use std.option.Option;

/// One table slot. `state` is 0 empty, 1 full, 2 removed.
struct Slot<V> {
    state: i64,
    hash: u64,
    key_start: i64,
    key_len: i64,
    value: V,
}

pub struct Map<V> {
    slots: Vec<Slot<V>>,
    arena: Bytes,
    /// Live entries.
    count: i64,
    /// Removed slots (they still continue probe chains).
    removed: i64,
    /// Bytes of the arena that belong to removed keys.
    garbage: i64,
    /// Stored in unused slots; never returned.
    filler: V,
}

/// FNV-1a over all of `key`.
pub fn hash(key: &Bytes) -> u64 ! {panic} {
    let mut h: u64 = 14695981039346656037;
    let n = Bytes.len(key);
    let mut i = 0;
    while i < n {
        let byte: u64 = Int.truncate(Bytes.at(key, i, _));
        h = Int.wrapping_mul(h ^ byte, 1099511628211);
        i = i + 1;
    }
    h
}

fn table<V>(count: i64, filler: V, arena_capacity: i64) -> Map<V> ! {alloc, panic} {
    let mut slots: Vec<Slot<V>> = Vec.with_capacity(count);
    let mut i = 0;
    while i < count {
        slots = Vec.push(slots, Slot { state: 0, hash: 0, key_start: 0, key_len: 0, value: filler });
        i = i + 1;
    }
    Map {
        slots: slots,
        arena: Bytes.with_capacity(arena_capacity),
        count: 0,
        removed: 0,
        garbage: 0,
        filler: filler,
    }
}

/// An empty map. `filler` is stored in unused slots and never returned.
pub fn new<V>(filler: V) -> Map<V> ! {alloc, panic} {
    table(16, filler, 256)
}

/// Number of live entries.
pub fn len<V>(map: &Map<V>) -> i64 ! {} {
    map.count
}

/// Number of slots, for iteration with `next_slot`.
pub fn slots<V>(map: &Map<V>) -> i64 ! {} {
    Vec.len(&map.slots)
}

/// Whether `arena[start .. start + len(key)]` equals `key`. One range check,
/// then reads proved in bounds.
fn same_bytes(arena: &Bytes, start: i64, key: &Bytes) -> Bool ! {panic} {
    let n = Bytes.len(key);
    if start < 0 || start > Bytes.len(arena) - n {
        return false;
    }
    let mut i = 0;
    while i < n {
        if Bytes.at(arena, start + i, _) != Bytes.at(key, i, _) {
            return false;
        }
        i = i + 1;
    }
    true
}

/// Append `source[start .. start + n]` to `out`, or nothing if the range is
/// outside `source`.
fn append_range(out: Bytes, source: &Bytes, start: i64, n: i64) -> Bytes ! {alloc, panic} {
    let mut out = out;
    if start < 0 || n < 0 || start > Bytes.len(source) - n {
        return out;
    }
    let mut i = start;
    while i < start + n {
        out = Bytes.push(out, Bytes.at(source, i, _));
        i = i + 1;
    }
    out
}

/// The first slot of `h`'s probe chain in a table of `count` slots (a power
/// of two).
fn home(h: u64, count: i64) -> i64 ! {panic} {
    let mask: u64 = Int.truncate(count - 1);
    Int.truncate(h & mask)
}

/// The slot holding `key`, or -1.
fn find<V>(map: &Map<V>, key: &Bytes, h: u64) -> i64 ! {panic} {
    let slots = &map.slots;
    let count = Vec.len(slots);
    let n = Bytes.len(key);
    let mut slot = home(h, count);
    let mut probes = 0;
    while probes < count {
        if slot < 0 || slot >= count {
            return -1;
        }
        let entry = Vec.at(slots, slot, _);
        if entry.state == 0 {
            return -1;
        }
        if entry.state == 1 && entry.hash == h && entry.key_len == n
            && same_bytes(&map.arena, entry.key_start, key)
        {
            return slot;
        }
        slot = slot + 1;
        if slot == count {
            slot = 0;
        }
        probes = probes + 1;
    };
    -1
}

/// The slot `find` returned, read once more (its index is in range).
fn entry_at<V>(map: &Map<V>, slot: i64) -> Slot<V> ! {panic} {
    Vec.get(&map.slots, slot)
}

pub fn get<V>(map: &Map<V>, key: &Bytes) -> Option<V> ! {panic} {
    let slot = find(map, key, hash(key));
    if slot < 0 { Option.None } else { Option.Some(entry_at(map, slot).value) }
}

pub fn contains<V>(map: &Map<V>, key: &Bytes) -> Bool ! {panic} {
    find(map, key, hash(key)) >= 0
}

/// The first free (empty or removed) slot on `h`'s probe chain. The table
/// always has an empty slot, so this terminates.
fn free_slot<V>(map: &Map<V>, h: u64) -> i64 ! {panic} {
    let slots = &map.slots;
    let count = Vec.len(slots);
    let mut slot = home(h, count);
    while slot >= 0 && slot < count && Vec.at(slots, slot, _).state == 1 {
        slot = slot + 1;
        if slot == count {
            slot = 0;
        }
    };
    slot
}

/// Store a new key, known to be absent, from `source[start .. start + n]`.
fn place<V>(map: Map<V>, source: &Bytes, start: i64, n: i64, h: u64, value: V) -> Map<V> ! {alloc, panic} {
    let slot = free_slot(&map, h);
    let Map { slots, arena, count, removed, garbage, filler } = map;
    let was_removed = Vec.get(&slots, slot).state == 2;
    let offset = Bytes.len(&arena);
    let arena = append_range(arena, source, start, n);
    Map {
        slots: Vec.set(slots, slot, Slot { state: 1, hash: h, key_start: offset, key_len: n, value: value }),
        arena: arena,
        count: count + 1,
        removed: if was_removed { removed - 1 } else { removed },
        garbage: garbage,
        filler: filler,
    }
}

/// Rebuild into `count` slots, dropping tombstones and arena garbage.
fn rebuild<V>(map: Map<V>, count: i64) -> Map<V> ! {alloc, panic} {
    let mut fresh = table(count, map.filler, Bytes.len(&map.arena) - map.garbage + 16);
    let old = &map.slots;
    let old_count = Vec.len(old);
    let mut slot = 0;
    while slot < old_count {
        let entry = Vec.at(old, slot, _);
        if entry.state == 1 {
            fresh = place(fresh, &map.arena, entry.key_start, entry.key_len, entry.hash, entry.value);
        }
        slot = slot + 1;
    }
    drop(map);
    fresh
}

/// Insert or replace the value for `key`.
pub fn insert<V>(map: Map<V>, key: &Bytes, value: V) -> Map<V> ! {alloc, panic} {
    let (map, previous) = replace(map, key, value);
    map
}

/// Insert or replace the value for `key`, returning the value it replaced:
/// one lookup where `get` followed by `insert` needs two.
pub fn replace<V>(map: Map<V>, key: &Bytes, value: V) -> (Map<V>, Option<V>) ! {alloc, panic} {
    let h = hash(key);
    let existing = find(&map, key, h);
    if existing >= 0 {
        let Map { slots, arena, count, removed, garbage, filler } = map;
        let entry = Vec.get(&slots, existing);
        return (
            Map {
                slots: Vec.set(slots, existing, Slot {
                    state: 1,
                    hash: entry.hash,
                    key_start: entry.key_start,
                    key_len: entry.key_len,
                    value: value,
                }),
                arena: arena,
                count: count,
                removed: removed,
                garbage: garbage,
                filler: filler,
            },
            Option.Some(entry.value),
        );
    }
    // Keep the load (live + removed) at most 3/4 after this insert.
    let count = Vec.len(&map.slots);
    let mut map = map;
    if (map.count + map.removed + 1) * 4 > count * 3 {
        let grown = if (map.count + 1) * 2 > count { count * 2 } else { count };
        map = rebuild(map, grown);
    };
    (place(map, key, 0, Bytes.len(key), h, value), Option.None)
}

/// Remove `key` if present.
pub fn remove<V>(map: Map<V>, key: &Bytes) -> Map<V> ! {alloc, panic} {
    let slot = find(&map, key, hash(key));
    if slot < 0 {
        return map;
    }
    let Map { slots, arena, count, removed, garbage, filler } = map;
    let entry = Vec.get(&slots, slot);
    let map = Map {
        slots: Vec.set(slots, slot, Slot {
            state: 2,
            hash: entry.hash,
            key_start: entry.key_start,
            key_len: entry.key_len,
            value: filler,
        }),
        arena: arena,
        count: count - 1,
        removed: removed + 1,
        garbage: garbage + entry.key_len,
        filler: filler,
    };
    // Reclaim the arena when most of it is garbage.
    if map.garbage > 4096 && map.garbage * 2 > Bytes.len(&map.arena) {
        let count = Vec.len(&map.slots);
        return rebuild(map, count);
    }
    map
}

/// The first full slot at or after `from`, or -1 when there is none.
pub fn next_slot<V>(map: &Map<V>, from: i64) -> i64 ! {panic} {
    let slots = &map.slots;
    let count = Vec.len(slots);
    let mut slot = if from < 0 { 0 } else { from };
    while slot >= 0 && slot < count {
        if Vec.at(slots, slot, _).state == 1 {
            return slot;
        }
        slot = slot + 1;
    };
    -1
}

/// Append the key stored in full slot `slot` to `out`.
pub fn key_into<V>(map: &Map<V>, slot: i64, out: Bytes) -> Bytes ! {alloc, panic} {
    let entry = entry_at(map, slot);
    append_range(out, &map.arena, entry.key_start, entry.key_len)
}

/// The value stored in full slot `slot`.
pub fn value_at<V>(map: &Map<V>, slot: i64) -> V ! {panic} {
    entry_at(map, slot).value
}
