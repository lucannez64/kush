    }

    /// Every lane shifted left by `n` (high bits dropped).
    pub fn shl(v: i16x8, n: i64, erased q: { 0 <= n && n <= 15 }) -> i16x8 ! {} {
        let lanemax: u64 = 65535;
        let keep: u64 = Int.wrapping_mul::<u64>((lanemax << n) & lanemax, 281479271743489);
        Self { w0: (v.w0 << n) & keep, w1: (v.w1 << n) & keep }
    }

    /// Every lane shifted right by `n`, keeping its sign.
    pub fn shr(v: i16x8, n: i64, erased q: { 0 <= n && n <= 15 }) -> i16x8 ! {} {
