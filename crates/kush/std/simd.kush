        } else {
            Int.truncate::<i16>(v.w1 >> (16 * (i - 4)))
        }
    }

    /// `v` with lane `i` replaced by `x`.
    pub fn with_lane(v: i16x8, i: i64, x: i16, erased q: { 0 <= i && i <= 7 }) -> i16x8 ! {} {
        let b: u64 = Int.convert::<u64>(Int.truncate::<u16>(x));
        let mask: u64 = 65535;
        if i < 4 {
            let s = 16 * i;
            Self { w0: (v.w0 & !(mask << s)) | (b << s), w1: v.w1 }
