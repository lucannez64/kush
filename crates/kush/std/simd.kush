    /// The 16 bytes at data[at..at + 16], each lane little-endian. `n` is
    /// `Bytes.len(data)`, an `i64` local of the caller.
    pub fn load_le(data: &Bytes, n: i64, at: i64, erased q: { 0 <= at && at + 16 <= n && n == Bytes.len(data) }) -> i8x16 ! {} {
