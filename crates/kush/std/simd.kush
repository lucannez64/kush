    }

    /// Lane-wise `^`.
    pub fn xor(a: i16x8, b: i16x8) -> i16x8 ! {} {
        Self { w0: a.w0 ^ b.w0, w1: a.w1 ^ b.w1 }
    }

    /// Lane-wise `!`.
