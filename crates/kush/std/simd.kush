        if i < 8 { u16x8.lane(a, i, _) } else { u16x8.lane(b, i - 8, _) }
    }

    /// Lane `k` of the result is lane `i<k>` of `a` then `b` side by side
    /// (indices 8 and up name lanes of `b`).
    pub fn shuffle2(a: u16x8, b: u16x8, i0: i64, i1: i64, i2: i64, i3: i64, i4: i64, i5: i64, i6: i64, i7: i64, erased q: { 0 <= i0 && i0 <= 15 && 0 <= i1 && i1 <= 15 && 0 <= i2 && i2 <= 15 && 0 <= i3 && i3 <= 15 && 0 <= i4 && i4 <= 15 && 0 <= i5 && i5 <= 15 && 0 <= i6 && i6 <= 15 && 0 <= i7 && i7 <= 15 }) -> u16x8 ! {} {
        u16x8.new(u16x8.pick(a, b, i0, _), u16x8.pick(a, b, i1, _), u16x8.pick(a, b, i2, _), u16x8.pick(a, b, i3, _), u16x8.pick(a, b, i4, _), u16x8.pick(a, b, i5, _), u16x8.pick(a, b, i6, _), u16x8.pick(a, b, i7, _))
    }

    /// Every lane with its bytes reversed (big-endian <-> little-endian).
    pub fn swap_bytes(v: u16x8) -> u16x8 ! {} {
        let b = u8x16.from_bits(u16x8.to_bits(v));
        u16x8.from_bits(u8x16.to_bits(u8x16.shuffle(b, 1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10, 13, 12, 15, 14, _)))
    }

    /// The 16 bytes at data[at..at + 16], each lane little-endian. `n` is
    /// `Bytes.len(data)`, an `i64` local of the caller.
    pub fn load_le(data: &Bytes, n: i64, at: i64, erased q: { 0 <= at && at + 16 <= n && n == Bytes.len(data) }) -> u16x8 ! {} {
        let b00: u64 = Int.truncate(Bytes.at(data, at + 0, _));
        let b01: u64 = Int.truncate(Bytes.at(data, at + 1, _));
        let b02: u64 = Int.truncate(Bytes.at(data, at + 2, _));
        let b03: u64 = Int.truncate(Bytes.at(data, at + 3, _));
        let b04: u64 = Int.truncate(Bytes.at(data, at + 4, _));
        let b05: u64 = Int.truncate(Bytes.at(data, at + 5, _));
        let b06: u64 = Int.truncate(Bytes.at(data, at + 6, _));
        let b07: u64 = Int.truncate(Bytes.at(data, at + 7, _));
        let w0: u64 = b00 | (b01 << 8) | (b02 << 16) | (b03 << 24) | (b04 << 32) | (b05 << 40) | (b06 << 48) | (b07 << 56);
        let b10: u64 = Int.truncate(Bytes.at(data, at + 8, _));
        let b11: u64 = Int.truncate(Bytes.at(data, at + 9, _));
        let b12: u64 = Int.truncate(Bytes.at(data, at + 10, _));
        let b13: u64 = Int.truncate(Bytes.at(data, at + 11, _));
        let b14: u64 = Int.truncate(Bytes.at(data, at + 12, _));
        let b15: u64 = Int.truncate(Bytes.at(data, at + 13, _));
        let b16: u64 = Int.truncate(Bytes.at(data, at + 14, _));
        let b17: u64 = Int.truncate(Bytes.at(data, at + 15, _));
        let w1: u64 = b10 | (b11 << 8) | (b12 << 16) | (b13 << 24) | (b14 << 32) | (b15 << 40) | (b16 << 48) | (b17 << 56);
        Self { w0: w0, w1: w1 }
    }

    /// The 16 bytes at data[at..at + 16], each lane big-endian. Built
    /// with shifts, not a byte shuffle, which the x86-64 baseline lacks.
    pub fn load_be(data: &Bytes, n: i64, at: i64, erased q: { 0 <= at && at + 16 <= n && n == Bytes.len(data) }) -> u16x8 ! {} {
        let b00: u64 = Int.truncate(Bytes.at(data, at + 0, _));
        let b01: u64 = Int.truncate(Bytes.at(data, at + 1, _));
        let b02: u64 = Int.truncate(Bytes.at(data, at + 2, _));
        let b03: u64 = Int.truncate(Bytes.at(data, at + 3, _));
        let b04: u64 = Int.truncate(Bytes.at(data, at + 4, _));
        let b05: u64 = Int.truncate(Bytes.at(data, at + 5, _));
        let b06: u64 = Int.truncate(Bytes.at(data, at + 6, _));
        let b07: u64 = Int.truncate(Bytes.at(data, at + 7, _));
        let w0: u64 = (b00 << 8) | b01 | (b02 << 24) | (b03 << 16) | (b04 << 40) | (b05 << 32) | (b06 << 56) | (b07 << 48);
        let b10: u64 = Int.truncate(Bytes.at(data, at + 8, _));
        let b11: u64 = Int.truncate(Bytes.at(data, at + 9, _));
        let b12: u64 = Int.truncate(Bytes.at(data, at + 10, _));
        let b13: u64 = Int.truncate(Bytes.at(data, at + 11, _));
        let b14: u64 = Int.truncate(Bytes.at(data, at + 12, _));
        let b15: u64 = Int.truncate(Bytes.at(data, at + 13, _));
        let b16: u64 = Int.truncate(Bytes.at(data, at + 14, _));
        let b17: u64 = Int.truncate(Bytes.at(data, at + 15, _));
        let w1: u64 = (b10 << 8) | b11 | (b12 << 24) | (b13 << 16) | (b14 << 40) | (b15 << 32) | (b16 << 56) | (b17 << 48);
        Self { w0: w0, w1: w1 }
    }

    /// `out` with the 16 bytes of `v` appended, each lane little-endian.
    pub fn push_le(out: Bytes, v: u16x8) -> Bytes ! {alloc, panic} {
        let mut out = out;
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 0) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 8) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 16) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 24) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 32) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 40) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 48) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 56) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 0) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 8) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 16) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 24) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 32) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 40) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 48) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 56) & 255));
        out
    }

    /// `out` with the 16 bytes of `v` appended, each lane big-endian.
    pub fn push_be(out: Bytes, v: u16x8) -> Bytes ! {alloc, panic} {
        u16x8.push_le(out, u16x8.swap_bytes(v))
    }
}

/// 4 lanes of `u32` in 128 bits.
pub struct u32x4 {
    w0: u64,
    w1: u64,
}

impl u32x4 {
    /// The vector with lanes `l0` (lowest) to `l3`.
    pub fn new(l0: u32, l1: u32, l2: u32, l3: u32) -> u32x4 ! {} {
        let w0: u64 = Int.convert::<u64>(l0) | (Int.convert::<u64>(l1) << 32);
        let w1: u64 = Int.convert::<u64>(l2) | (Int.convert::<u64>(l3) << 32);
        Self { w0: w0, w1: w1 }
    }

    /// Every lane `x`.
    pub fn splat(x: u32) -> u32x4 ! {} {
        let b: u64 = Int.convert::<u64>(x);
        let w: u64 = b | (b << 32);
        Self { w0: w, w1: w }
    }

    /// Every lane zero.
    pub fn zero() -> u32x4 ! {} {
        Self { w0: 0, w1: 0 }
    }

    /// Lane `i` (0 is the lowest).
    pub fn lane(v: u32x4, i: i64, erased q: { 0 <= i && i <= 3 }) -> u32 ! {} {
        if i < 2 {
            Int.truncate::<u32>(v.w0 >> (32 * i))
        } else {
            Int.truncate::<u32>(v.w1 >> (32 * (i - 2)))
        }
    }

    /// `v` with lane `i` replaced by `x`.
    pub fn with_lane(v: u32x4, i: i64, x: u32, erased q: { 0 <= i && i <= 3 }) -> u32x4 ! {} {
        let b: u64 = Int.convert::<u64>(x);
        let mask: u64 = 4294967295;
        if i < 2 {
            let s = 32 * i;
            Self { w0: (v.w0 & !(mask << s)) | (b << s), w1: v.w1 }
        } else {
            let s = 32 * (i - 2);
            Self { w0: v.w0, w1: (v.w1 & !(mask << s)) | (b << s) }
        }
    }

    /// Whether every lane is equal.
    pub fn eq(a: u32x4, b: u32x4) -> Bool ! {} {
        a.w0 == b.w0 && a.w1 == b.w1
    }

    /// The 128 bits as two words, low word first (for reinterpreting).
    pub fn to_bits(v: u32x4) -> (u64, u64) ! {} {
        (v.w0, v.w1)
    }

    /// The vector with these 128 bits, low word first.
    pub fn from_bits(bits: (u64, u64)) -> u32x4 ! {} {
        let (w0, w1) = bits;
        Self { w0: w0, w1: w1 }
    }

    /// Lane-wise `&`.
    pub fn and(a: u32x4, b: u32x4) -> u32x4 ! {} {
        Self { w0: a.w0 & b.w0, w1: a.w1 & b.w1 }
    }

    /// Lane-wise `|`.
    pub fn or(a: u32x4, b: u32x4) -> u32x4 ! {} {
        Self { w0: a.w0 | b.w0, w1: a.w1 | b.w1 }
    }

    /// Lane-wise `^`.
    pub fn xor(a: u32x4, b: u32x4) -> u32x4 ! {} {
        Self { w0: a.w0 ^ b.w0, w1: a.w1 ^ b.w1 }
    }

    /// Lane-wise `!`.
    pub fn not(v: u32x4) -> u32x4 ! {} {
        Self { w0: !v.w0, w1: !v.w1 }
    }

    /// Lane-wise addition modulo 2^32.
    pub fn wrapping_add(a: u32x4, b: u32x4) -> u32x4 ! {} {
        Self { w0: Int.wrapping_add::<u64>(a.w0 & 9223372034707292159, b.w0 & 9223372034707292159) ^ ((a.w0 ^ b.w0) & 9223372039002259456), w1: Int.wrapping_add::<u64>(a.w1 & 9223372034707292159, b.w1 & 9223372034707292159) ^ ((a.w1 ^ b.w1) & 9223372039002259456) }
    }

    /// Lane-wise subtraction modulo 2^32.
    pub fn wrapping_sub(a: u32x4, b: u32x4) -> u32x4 ! {} {
        Self { w0: Int.wrapping_sub::<u64>(a.w0 | 9223372039002259456, b.w0 & 9223372034707292159) ^ ((a.w0 ^ !b.w0) & 9223372039002259456), w1: Int.wrapping_sub::<u64>(a.w1 | 9223372039002259456, b.w1 & 9223372034707292159) ^ ((a.w1 ^ !b.w1) & 9223372039002259456) }
    }

    /// Every lane shifted left by `n` (high bits dropped).
    pub fn shl(v: u32x4, n: i64, erased q: { 0 <= n && n <= 31 }) -> u32x4 ! {} {
        let lanemax: u64 = 4294967295;
        let keep: u64 = Int.wrapping_mul::<u64>((lanemax << n) & lanemax, 4294967297);
        Self { w0: (v.w0 << n) & keep, w1: (v.w1 << n) & keep }
    }

    /// Every lane shifted right by `n`.
    pub fn shr(v: u32x4, n: i64, erased q: { 0 <= n && n <= 31 }) -> u32x4 ! {} {
        let lanemax: u64 = 4294967295;
        let keep: u64 = Int.wrapping_mul::<u64>(lanemax >> n, 4294967297);
        Self { w0: (v.w0 >> n) & keep, w1: (v.w1 >> n) & keep }
    }

    /// All ones in every lane where `a` and `b` are equal, zero elsewhere.
    pub fn eq_lanes(a: u32x4, b: u32x4) -> u32x4 ! {} {
        let lanemax: u64 = 4294967295;
        let x0 = a.w0 ^ b.w0;
        let x1 = a.w1 ^ b.w1;
        Self { w0: Int.wrapping_mul::<u64>((!((Int.wrapping_add::<u64>(x0 & 9223372034707292159, 9223372034707292159) | x0) & 9223372039002259456) & 9223372039002259456) >> 31, lanemax), w1: Int.wrapping_mul::<u64>((!((Int.wrapping_add::<u64>(x1 & 9223372034707292159, 9223372034707292159) | x1) & 9223372039002259456) & 9223372039002259456) >> 31, lanemax) }
    }

    /// Lane `k` of the result is lane `i<k>` of `v`.
    pub fn shuffle(v: u32x4, i0: i64, i1: i64, i2: i64, i3: i64, erased q: { 0 <= i0 && i0 <= 3 && 0 <= i1 && i1 <= 3 && 0 <= i2 && i2 <= 3 && 0 <= i3 && i3 <= 3 }) -> u32x4 ! {} {
        u32x4.new(u32x4.lane(v, i0, _), u32x4.lane(v, i1, _), u32x4.lane(v, i2, _), u32x4.lane(v, i3, _))
    }

    /// Lane `i` of `a` for `i < 4`, else lane `i - 4` of `b`.
    fn pick(a: u32x4, b: u32x4, i: i64, erased q: { 0 <= i && i <= 7 }) -> u32 ! {} {
        if i < 4 { u32x4.lane(a, i, _) } else { u32x4.lane(b, i - 4, _) }
    }

    /// Lane `k` of the result is lane `i<k>` of `a` then `b` side by side
    /// (indices 4 and up name lanes of `b`).
    pub fn shuffle2(a: u32x4, b: u32x4, i0: i64, i1: i64, i2: i64, i3: i64, erased q: { 0 <= i0 && i0 <= 7 && 0 <= i1 && i1 <= 7 && 0 <= i2 && i2 <= 7 && 0 <= i3 && i3 <= 7 }) -> u32x4 ! {} {
        u32x4.new(u32x4.pick(a, b, i0, _), u32x4.pick(a, b, i1, _), u32x4.pick(a, b, i2, _), u32x4.pick(a, b, i3, _))
    }

    /// Every lane with its bytes reversed (big-endian <-> little-endian).
    pub fn swap_bytes(v: u32x4) -> u32x4 ! {} {
        let b = u8x16.from_bits(u32x4.to_bits(v));
        u32x4.from_bits(u8x16.to_bits(u8x16.shuffle(b, 3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12, _)))
    }

    /// The 16 bytes at data[at..at + 16], each lane little-endian. `n` is
    /// `Bytes.len(data)`, an `i64` local of the caller.
    pub fn load_le(data: &Bytes, n: i64, at: i64, erased q: { 0 <= at && at + 16 <= n && n == Bytes.len(data) }) -> u32x4 ! {} {
        let b00: u64 = Int.truncate(Bytes.at(data, at + 0, _));
        let b01: u64 = Int.truncate(Bytes.at(data, at + 1, _));
        let b02: u64 = Int.truncate(Bytes.at(data, at + 2, _));
        let b03: u64 = Int.truncate(Bytes.at(data, at + 3, _));
        let b04: u64 = Int.truncate(Bytes.at(data, at + 4, _));
        let b05: u64 = Int.truncate(Bytes.at(data, at + 5, _));
        let b06: u64 = Int.truncate(Bytes.at(data, at + 6, _));
        let b07: u64 = Int.truncate(Bytes.at(data, at + 7, _));
        let w0: u64 = b00 | (b01 << 8) | (b02 << 16) | (b03 << 24) | (b04 << 32) | (b05 << 40) | (b06 << 48) | (b07 << 56);
        let b10: u64 = Int.truncate(Bytes.at(data, at + 8, _));
        let b11: u64 = Int.truncate(Bytes.at(data, at + 9, _));
        let b12: u64 = Int.truncate(Bytes.at(data, at + 10, _));
        let b13: u64 = Int.truncate(Bytes.at(data, at + 11, _));
        let b14: u64 = Int.truncate(Bytes.at(data, at + 12, _));
        let b15: u64 = Int.truncate(Bytes.at(data, at + 13, _));
        let b16: u64 = Int.truncate(Bytes.at(data, at + 14, _));
        let b17: u64 = Int.truncate(Bytes.at(data, at + 15, _));
        let w1: u64 = b10 | (b11 << 8) | (b12 << 16) | (b13 << 24) | (b14 << 32) | (b15 << 40) | (b16 << 48) | (b17 << 56);
        Self { w0: w0, w1: w1 }
    }

    /// The 16 bytes at data[at..at + 16], each lane big-endian. Built
    /// with shifts, not a byte shuffle, which the x86-64 baseline lacks.
    pub fn load_be(data: &Bytes, n: i64, at: i64, erased q: { 0 <= at && at + 16 <= n && n == Bytes.len(data) }) -> u32x4 ! {} {
        let b00: u64 = Int.truncate(Bytes.at(data, at + 0, _));
        let b01: u64 = Int.truncate(Bytes.at(data, at + 1, _));
        let b02: u64 = Int.truncate(Bytes.at(data, at + 2, _));
        let b03: u64 = Int.truncate(Bytes.at(data, at + 3, _));
        let b04: u64 = Int.truncate(Bytes.at(data, at + 4, _));
        let b05: u64 = Int.truncate(Bytes.at(data, at + 5, _));
        let b06: u64 = Int.truncate(Bytes.at(data, at + 6, _));
        let b07: u64 = Int.truncate(Bytes.at(data, at + 7, _));
        let w0: u64 = (b00 << 24) | (b01 << 16) | (b02 << 8) | b03 | (b04 << 56) | (b05 << 48) | (b06 << 40) | (b07 << 32);
        let b10: u64 = Int.truncate(Bytes.at(data, at + 8, _));
        let b11: u64 = Int.truncate(Bytes.at(data, at + 9, _));
        let b12: u64 = Int.truncate(Bytes.at(data, at + 10, _));
        let b13: u64 = Int.truncate(Bytes.at(data, at + 11, _));
        let b14: u64 = Int.truncate(Bytes.at(data, at + 12, _));
        let b15: u64 = Int.truncate(Bytes.at(data, at + 13, _));
        let b16: u64 = Int.truncate(Bytes.at(data, at + 14, _));
        let b17: u64 = Int.truncate(Bytes.at(data, at + 15, _));
        let w1: u64 = (b10 << 24) | (b11 << 16) | (b12 << 8) | b13 | (b14 << 56) | (b15 << 48) | (b16 << 40) | (b17 << 32);
        Self { w0: w0, w1: w1 }
    }

    /// `out` with the 16 bytes of `v` appended, each lane little-endian.
    pub fn push_le(out: Bytes, v: u32x4) -> Bytes ! {alloc, panic} {
        let mut out = out;
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 0) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 8) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 16) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 24) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 32) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 40) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 48) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w0 >> 56) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 0) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 8) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 16) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 24) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 32) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 40) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 48) & 255));
        out = Bytes.push(out, Int.truncate::<i64>((v.w1 >> 56) & 255));
        out
    }

    /// `out` with the 16 bytes of `v` appended, each lane big-endian.
    pub fn push_be(out: Bytes, v: u32x4) -> Bytes ! {alloc, panic} {
        u32x4.push_le(out, u32x4.swap_bytes(v))
    }
}

/// 2 lanes of `u64` in 128 bits.
pub struct u64x2 {
    w0: u64,
    w1: u64,
}

impl u64x2 {
    /// The vector with lanes `l0` (lowest) to `l1`.
    pub fn new(l0: u64, l1: u64) -> u64x2 ! {} {
        let w0: u64 = l0;
        let w1: u64 = l1;
        Self { w0: w0, w1: w1 }
    }

    /// Every lane `x`.
    pub fn splat(x: u64) -> u64x2 ! {} {
        let b: u64 = x;
        Self { w0: b, w1: b }
    }

    /// Every lane zero.
    pub fn zero() -> u64x2 ! {} {
        Self { w0: 0, w1: 0 }
    }

    /// Lane `i` (0 is the lowest).
    pub fn lane(v: u64x2, i: i64, erased q: { 0 <= i && i <= 1 }) -> u64 ! {} {
        if i == 0 { v.w0 } else { v.w1 }
    }

    /// `v` with lane `i` replaced by `x`.
    pub fn with_lane(v: u64x2, i: i64, x: u64, erased q: { 0 <= i && i <= 1 }) -> u64x2 ! {} {
        let b: u64 = x;
        if i == 0 { Self { w0: b, w1: v.w1 } } else { Self { w0: v.w0, w1: b } }
    }

    /// Whether every lane is equal.
    pub fn eq(a: u64x2, b: u64x2) -> Bool ! {} {
        a.w0 == b.w0 && a.w1 == b.w1
    }

    /// The 128 bits as two words, low word first (for reinterpreting).
    pub fn to_bits(v: u64x2) -> (u64, u64) ! {} {
        (v.w0, v.w1)
    }

    /// The vector with these 128 bits, low word first.
    pub fn from_bits(bits: (u64, u64)) -> u64x2 ! {} {
        let (w0, w1) = bits;
        Self { w0: w0, w1: w1 }
    }

    /// Lane-wise `&`.
    pub fn and(a: u64x2, b: u64x2) -> u64x2 ! {} {
        Self { w0: a.w0 & b.w0, w1: a.w1 & b.w1 }
    }

    /// Lane-wise `|`.
    pub fn or(a: u64x2, b: u64x2) -> u64x2 ! {} {
        Self { w0: a.w0 | b.w0, w1: a.w1 | b.w1 }
    }

    /// Lane-wise `^`.
    pub fn xor(a: u64x2, b: u64x2) -> u64x2 ! {} {
        Self { w0: a.w0 ^ b.w0, w1: a.w1 ^ b.w1 }
    }

    /// Lane-wise `!`.
    pub fn not(v: u64x2) -> u64x2 ! {} {
        Self { w0: !v.w0, w1: !v.w1 }
    }

    /// Lane-wise addition modulo 2^64.
    pub fn wrapping_add(a: u64x2, b: u64x2) -> u64x2 ! {} {
        Self { w0: Int.wrapping_add::<u64>(a.w0, b.w0), w1: Int.wrapping_add::<u64>(a.w1, b.w1) }
    }

    /// Lane-wise subtraction modulo 2^64.
    pub fn wrapping_sub(a: u64x2, b: u64x2) -> u64x2 ! {} {
        Self { w0: Int.wrapping_sub::<u64>(a.w0, b.w0), w1: Int.wrapping_sub::<u64>(a.w1, b.w1) }
    }

    /// Every lane shifted left by `n` (high bits dropped).
    pub fn shl(v: u64x2, n: i64, erased q: { 0 <= n && n <= 63 }) -> u64x2 ! {} {
        Self { w0: v.w0 << n, w1: v.w1 << n }
    }

    /// Every lane shifted right by `n`.
    pub fn shr(v: u64x2, n: i64, erased q: { 0 <= n && n <= 63 }) -> u64x2 ! {} {
        Self { w0: v.w0 >> n, w1: v.w1 >> n }
    }

    /// All ones in every lane where `a` and `b` are equal, zero elsewhere.
    pub fn eq_lanes(a: u64x2, b: u64x2) -> u64x2 ! {} {
        let m0: u64 = if a.w0 == b.w0 { 18446744073709551615 } else { 0 };
        let m1: u64 = if a.w1 == b.w1 { 18446744073709551615 } else { 0 };
        Self { w0: m0, w1: m1 }
    }

    /// Lane `k` of the result is lane `i<k>` of `v`.
    pub fn shuffle(v: u64x2, i0: i64, i1: i64, erased q: { 0 <= i0 && i0 <= 1 && 0 <= i1 && i1 <= 1 }) -> u64x2 ! {} {
        u64x2.new(u64x2.lane(v, i0, _), u64x2.lane(v, i1, _))
    }

    /// Lane `i` of `a` for `i < 2`, else lane `i - 2` of `b`.
    fn pick(a: u64x2, b: u64x2, i: i64, erased q: { 0 <= i && i <= 3 }) -> u64 ! {} {
        if i < 2 { u64x2.lane(a, i, _) } else { u64x2.lane(b, i - 2, _) }
    }

    /// Lane `k` of the result is lane `i<k>` of `a` then `b` side by side
    /// (indices 2 and up name lanes of `b`).
    pub fn shuffle2(a: u64x2, b: u64x2, i0: i64, i1: i64, erased q: { 0 <= i0 && i0 <= 3 && 0 <= i1 && i1 <= 3 }) -> u64x2 ! {} {
