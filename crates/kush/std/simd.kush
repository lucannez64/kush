impl i16x8 {
    /// The vector with lanes `l0` (lowest) to `l7`.
    pub fn new(l0: i16, l1: i16, l2: i16, l3: i16, l4: i16, l5: i16, l6: i16, l7: i16) -> i16x8 ! {} {
