    }

    /// Lane `k` of the result is lane `i<k>` of `v`.
    pub fn shuffle(v: i16x8, i0: i64, i1: i64, i2: i64, i3: i64, i4: i64, i5: i64, i6: i64, i7: i64, erased q: { 0 <= i0 && i0 <= 7 && 0 <= i1 && i1 <= 7 && 0 <= i2 && i2 <= 7 && 0 <= i3 && i3 <= 7 && 0 <= i4 && i4 <= 7 && 0 <= i5 && i5 <= 7 && 0 <= i6 && i6 <= 7 && 0 <= i7 && i7 <= 7 }) -> i16x8 ! {} {
