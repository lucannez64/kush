        i16x8.new(i16x8.pick(a, b, i0, _), i16x8.pick(a, b, i1, _), i16x8.pick(a, b, i2, _), i16x8.pick(a, b, i3, _), i16x8.pick(a, b, i4, _), i16x8.pick(a, b, i5, _), i16x8.pick(a, b, i6, _), i16x8.pick(a, b, i7, _))
